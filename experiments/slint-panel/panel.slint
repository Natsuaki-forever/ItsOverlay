        }
        HorizontalLayout {
            height: 44px;
            spacing: 8px;
            Text {
                text: root.busy ? "正在处理…"
                    : root.status != "" ? root.status
                    : root.loaded-text != root.draft ? "正在同步修改…"
                    : "所有更改已自动保存 · " + (root.position-status == "" ? "就绪" : root.position-status);
                color: root.muted; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide;
            }
            PanelButton { width: 52px; dark: root.dark; quiet: true; text: "撤销"; enabled: root.can-undo && !root.busy; clicked => { root.undo(); } }
            PanelButton { width: 52px; dark: root.dark; quiet: true; text: "重做"; enabled: root.can-redo && !root.busy; clicked => { root.redo(); } }
            PanelButton { width: 78px; dark: root.dark; text: "完成"; primary: true; enabled: !root.busy; clicked => { root.finish(); } }
        }
    }
    if root.confirm-clear || root.confirm-delete: Rectangle {
        width: 100%; height: 100%;
        border-radius: 8px;
        background: #00000044;
    }
    if root.region-menu-open || root.confirm-clear || root.confirm-delete: TouchArea {
        clicked => { root.region-menu-open = false; root.confirm-clear = false; root.confirm-delete = false; }
    }
    if root.region-menu-open: GlassSurface {
        x: 36px; y: min(root.region-menu-y + 2px, root.height - 232px);
        width: 195px; height: 220px; border-radius: 10px;
        dark: root.dark; fill: root.paper; edge: root.border;
        VerticalLayout {
            padding: 6px; spacing: 2px;
            PanelButton {
                dark: root.dark; quiet: true; menu-row: true; text: "跟随应用";
                enabled: !root.busy; current: root.selected >= 0 && !root.region-items[root.selected].scoped;
                clicked => { root.region-menu-open = false; root.set-option("scope_app", "", -1); }
            }
            PanelButton {
                dark: root.dark; quiet: true; menu-row: true; text: "只在指定窗口显示…";
                enabled: !root.busy; current: root.selected >= 0 && root.region-items[root.selected].scoped;
                clicked => { root.region-menu-open = false; root.set-option("scope_window", "", -1); }
            }
            PanelButton {
                dark: root.dark; quiet: true; menu-row: true; text: "复制区域";
                enabled: !root.busy && root.selected >= 0;
                clicked => { root.region-menu-open = false; root.duplicate-region(); }
            }
            PanelButton {
                dark: root.dark; quiet: true; menu-row: true; text: "复制样式";
                enabled: !root.busy && root.selected >= 0;
                clicked => { root.region-menu-open = false; root.copy-style(); }
            }
            PanelButton {
                dark: root.dark; quiet: true; menu-row: true; text: "粘贴样式";
                enabled: !root.busy && root.selected >= 0 && root.has-copied-style;
                clicked => { root.region-menu-open = false; root.paste-style(); }
            }
            PanelButton {
                dark: root.dark; quiet: true; menu-row: true; text: "删除区域…"; danger: true;
                enabled: !root.busy;
                clicked => { root.region-menu-open = false; root.confirm-delete = true; }
            }
        }
    }
    if root.confirm-clear || root.confirm-delete: GlassSurface {
        x: (root.width - self.width) / 2; y: (root.height - self.height) / 2;
        width: 290px; height: 106px; border-radius: 11px;
        dark: root.dark; fill: root.paper; edge: root.border;
        VerticalLayout {
            padding: 14px; spacing: 8px;
            Text {
                color: root.ink; horizontal-alignment: center;
                text: root.confirm-clear ? "清空当前显示的遮盖区域？" : "删除选中的遮盖区域？";
            }
            HorizontalLayout {
                height: 32px; spacing: 8px;
                PanelButton { dark: root.dark; text: "取消"; clicked => { root.confirm-delete = false; root.confirm-clear = false; } }
                PanelButton {
                    dark: root.dark; danger: true; enabled: !root.busy;
                    text: root.confirm-clear ? "确认清空" : "确认删除";
                    clicked => {
                        root.set-option(root.confirm-clear ? "clear" : "delete", "", -1);
                        root.confirm-delete = false; root.confirm-clear = false;
                    }
                }
            }
        }
    }
    if root.choosing-target: TouchArea {
        clicked => { root.choosing-target = false; root.pending-target = -1; }
    }
    if root.choosing-target: GlassSurface {
        x: 150px;
        y: 62px;
        width: max(304px, min(target-selector-shell.width, 460px));
        height: min(root.target-menu-height, root.height - 84px);
        border-radius: 11px;
        dark: root.dark;
        fill: root.dark ? #302a43 : #f5f2fa;
        edge: root.border;
        ScrollView {
            x: 6px; y: 6px; width: parent.width - 12px; height: parent.height - 12px;
            content-width: self.visible-width;
            menu-content := VerticalLayout {
                width: parent.visible-width;
                changed preferred-height => { root.target-menu-height = self.preferred-height + 12px; }
                spacing: 2px;
                for entry[index] in root.targets: VerticalLayout {
                    property <bool> is-app: entry.kind == "app" || entry.kind == "app-direct";
                    property <bool> show-row: is-app || entry.group == "" || entry.group == root.expanded-group;
                    height: show-row ? (entry.kind == "add" ? 37px : 35px) : 0px;
                    if show-row: VerticalLayout {
                        spacing: 0px;
                        if entry.kind == "add": Rectangle { height: 1px; background: root.border; opacity: 0.45; }
                        Rectangle {
                            height: 35px;
                            PanelButton {
                                width: parent.width; height: parent.height;
                                text: entry.kind == "add" ? "+  " + entry.title : entry.title;
                                menu-row: true; quiet: true; dark: root.dark;
                                active: is-app; current: entry.current && !is-app;
                                menu-indent: entry.group != "" && !is-app ? 24px : 0px;
                                enabled: !root.busy && entry.kind != "waiting";
                                clicked => {
                                    if entry.kind == "app" {
                                        root.expanded-group = root.expanded-group == entry.group ? "" : entry.group;
                                    } else if entry.kind == "manage" {
                                        root.choosing-target = false;
                                        root.manage-targets();
                                    } else {
                                        root.choose-target(index);
                                    }
                                }
                            }
                            if entry.kind == "window": Rectangle {
                                x: 9px; y: 9px; height: 17px; width: 18px;
                                border-radius: 4px;
                                background: entry.current ? #c9ee46 : root.selection;
                                Path {
                                    x: 4px; y: 4px; width: 10px; height: 9px; stroke: entry.current ? #252338 : root.ink;
                                    stroke-width: 1.25px;
                                    commands: "M 0 0 H 10 V 9 H 0 Z M 0 3 H 10";
                                }
                            }
                            if entry.kind == "app" || entry.kind == "manage" || (entry.current && !is-app): Path {
                                x: parent.width - 21px; y: 14px; height: 8px; width: 9px;
                                stroke: root.ink; stroke-width: 1.5px;
                                commands: entry.kind == "manage" ? "M 2 0 L 6 4 L 2 8"
                                    : entry.kind == "app" ? (root.expanded-group == entry.group ? "M 0 6 L 4 2 L 8 6" : "M 0 2 L 4 6 L 8 2")
                                    : "M 0 4 L 3 7 L 9 0";
                            }
                        }
                    }
                }
            }
        }
    }

    // Region Window Scope Popover
    if root.scope-picker-open: Rectangle {
        width: 100%; height: 100%;
        border-radius: 8px;
        background: #00000038;
        TouchArea { clicked => { root.scope-picker-open = false; } }
    }
    if root.scope-picker-open: GlassSurface {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: 360px;
        height: 250px;
        border-radius: 12px;
        dark: root.dark;
        fill: root.dark ? #302a43 : #f5f2fa;
        edge: root.border;
        VerticalLayout {
            padding: 14px;
            spacing: 8px;
            HorizontalLayout {
                height: 28px;
                Text {
                    horizontal-stretch: 1;
                    text: "只在指定窗口显示";
                    color: root.ink;
                    font-size: 15px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                PanelButton {
                    width: 56px; dark: root.dark; quiet: true; text: "关闭";
                    clicked => { root.scope-picker-open = false; }
                }
            }
            Text {
                text: "选择当前遮盖区域绑定的目标窗口：";
                color: root.muted;
                font-size: 12px;
            }
            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    width: parent.visible-width;
                    spacing: 4px;
                    PanelButton {
                        height: 34px;
                        menu-row: true; quiet: true; dark: root.dark;
                        text: "跟随整个应用（所有窗口均显示）";
                        current: root.selected >= 0 && !root.region-items[root.selected].scoped;
                        clicked => {
                            root.scope-picker-open = false;
                            root.set-option("scope_app", "", -1);
                        }
                    }
                    for entry[index] in root.targets: PanelButton {
                        height: 34px;
                        menu-row: true; quiet: true; dark: root.dark;
                        text: entry.title;
                        current: entry.current && root.selected >= 0 && root.region-items[root.selected].scoped;
                        clicked => {
                            root.scope-picker-open = false;
                            root.choose-target(index);
                        }
                    }
                }
            }
        }
    }

    // Visual Color Picker Popover
    if root.color-picker-open: Rectangle {
        width: 100%; height: 100%;
        border-radius: 8px;
        background: #00000038;
        TouchArea { clicked => { root.color-picker-open = false; } }
    }
    if root.color-picker-open: GlassSurface {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: 348px;
        height: 410px;
        border-radius: 12px;
        dark: root.dark;
        fill: root.dark ? #302a43 : #f5f2fa;
        edge: root.border;
        VerticalLayout {
            padding: 14px;
            spacing: 10px;
            HorizontalLayout {
                height: 28px;
                spacing: 8px;
                Rectangle {
                    width: 24px; height: 24px; y: 2px; border-radius: 6px;
                    background: root.color-picker-preview;
                    border-width: 1px;
                    border-color: root.dark ? #ffffff50 : #00000030;
                }
                Text {
                    horizontal-stretch: 1;
                    text: root.color-picker-title + " · 选色板";
                    color: root.ink;
                    font-size: 15px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                PanelButton {
                    width: 56px; dark: root.dark; quiet: true; text: "完成";
                    clicked => { root.color-picker-open = false; }
                }
            }

            // 2D Saturation / Value Square
            sv-box := Rectangle {
                height: 154px;
                border-radius: 8px;
                border-width: 1px;
                border-color: root.border;
                clip: true;
                background: @linear-gradient(90deg, #ffffff 0%, root.color-picker-hue-color 100%);
                Rectangle {
                    width: 100%; height: 100%;
                    background: @linear-gradient(180deg, #00000000 0%, #000000ff 100%);
                }
                Rectangle {
                    x: clamp(root.color-picker-s / 100, 0, 1) * (parent.width - 14px);
                    y: (1 - clamp(root.color-picker-v / 100, 0, 1)) * (parent.height - 14px);
                    width: 14px; height: 14px; border-radius: 7px;
                    border-width: 2px;
                    border-color: #ffffff;
                    background: root.color-picker-preview;
                }
                TouchArea {
                    moved => {
                        if self.pressed {
                            root.color-picker-s = clamp(self.mouse-x / self.width, 0, 1) * 100;
                            root.color-picker-v = (1 - clamp(self.mouse-y / self.height, 0, 1)) * 100;
                            root.preview-color-hsv(root.color-picker-h, root.color-picker-s, root.color-picker-v);
                        }
                    }
                    pointer-event(ev) => {
                        if ev.button == PointerEventButton.left {
                            if ev.kind == PointerEventKind.down {
                                root.color-picker-s = clamp(self.mouse-x / self.width, 0, 1) * 100;
                                root.color-picker-v = (1 - clamp(self.mouse-y / self.height, 0, 1)) * 100;
                                root.preview-color-hsv(root.color-picker-h, root.color-picker-s, root.color-picker-v);
                            } else if ev.kind == PointerEventKind.up {
                                root.commit-color-hsv(root.color-picker-h, root.color-picker-s, root.color-picker-v);
                            }
                        }
                    }
                }
            }

            // Hue Rainbow Slider Bar
            hue-bar := Rectangle {
                height: 18px;
                border-radius: 9px;
                border-width: 1px;
                border-color: root.border;
                clip: true;
                HorizontalLayout {
                    spacing: 0px;
                    Rectangle { horizontal-stretch: 1; background: @linear-gradient(90deg, #ff0000 0%, #ffff00 100%); }
                    Rectangle { horizontal-stretch: 1; background: @linear-gradient(90deg, #ffff00 0%, #00ff00 100%); }
                    Rectangle { horizontal-stretch: 1; background: @linear-gradient(90deg, #00ff00 0%, #00ffff 100%); }
                    Rectangle { horizontal-stretch: 1; background: @linear-gradient(90deg, #00ffff 0%, #0000ff 100%); }
                    Rectangle { horizontal-stretch: 1; background: @linear-gradient(90deg, #0000ff 0%, #ff00ff 100%); }
                    Rectangle { horizontal-stretch: 1; background: @linear-gradient(90deg, #ff00ff 0%, #ff0000 100%); }
                }
                Rectangle {
                    x: clamp(root.color-picker-h / 360, 0, 1) * (parent.width - 12px);
                    y: 1px;
                    width: 12px; height: 14px; border-radius: 6px;
                    border-width: 2px;
                    border-color: #ffffff;
                    background: root.color-picker-hue-color;
                }
                TouchArea {
                    moved => {
                        if self.pressed {
                            root.color-picker-h = clamp(self.mouse-x / self.width, 0, 1) * 360;
                            root.preview-color-hsv(root.color-picker-h, root.color-picker-s, root.color-picker-v);
                        }
                    }
                    pointer-event(ev) => {
                        if ev.button == PointerEventButton.left {
                            if ev.kind == PointerEventKind.down {
                                root.color-picker-h = clamp(self.mouse-x / self.width, 0, 1) * 360;
                                root.preview-color-hsv(root.color-picker-h, root.color-picker-s, root.color-picker-v);
                            } else if ev.kind == PointerEventKind.up {
                                root.commit-color-hsv(root.color-picker-h, root.color-picker-s, root.color-picker-v);
                            }
                        }
                    }
                }
            }

            // Hex Input & Screen Eyedropper
            HorizontalLayout {
                height: 32px;
                spacing: 8px;
                Text { width: 42px; text: "色号"; color: root.muted; font-size: 12px; vertical-alignment: center; }
                PanelTextField {
                    horizontal-stretch: 1;
                    dark: root.dark;
                    text <=> root.color-picker-hex;
                    accepted(val) => { root.select-color-hex(val); }
                }
                if root.color-picker-eyedropper-key != "": PanelButton {
                    width: 82px; dark: root.dark; text: "屏幕取色";
                    clicked => {
                        root.color-picker-open = false;
                        root.set-option(root.color-picker-eyedropper-key, "", -1);
                    }
                }
            }

            // Curated Standard Palette (2 rows x 10 swatches)
            VerticalLayout {
                spacing: 6px;
                Text { text: "精选色板"; color: root.muted; font-size: 11px; }
                ColorPresetStrip {
                    hexes: ["#000000", "#1e1e2e", "#212121", "#252338", "#3b4252", "#4c566a", "#8892b0", "#d8dee9", "#ececec", "#ffffff"];
                    colors: [#000000, #1e1e2e, #212121, #252338, #3b4252, #4c566a, #8892b0, #d8dee9, #ececec, #ffffff];
                    current: root.color-picker-hex;
                    dark: root.dark;
                    picked(hex) => { root.select-color-hex(hex); }
                }
                ColorPresetStrip {
                    hexes: ["#ff5c6c", "#ff9e64", "#f0c674", "#c9ee46", "#43c569", "#2ab89d", "#58a6ff", "#7aa2f7", "#bb9af7", "#ff6b9d"];
                    colors: [#ff5c6c, #ff9e64, #f0c674, #c9ee46, #43c569, #2ab89d, #58a6ff, #7aa2f7, #bb9af7, #ff6b9d];
                    current: root.color-picker-hex;
                    dark: root.dark;
                    picked(hex) => { root.select-color-hex(hex); }
                }
            }

            // Recent Colors
            HorizontalLayout {
                height: 22px;
                spacing: 8px;
                Text { width: 52px; text: "最近使用"; color: root.muted; font-size: 11px; vertical-alignment: center; }
                ColorPresetStrip {
                    hexes: root.recent-color-hexes;
                    colors: root.recent-color-swatches;
                    current: root.color-picker-hex;
                    dark: root.dark;
                    picked(hex) => { root.select-color-hex(hex); }
                }
            }
        }
    }

    // Centered Application & Window Configuration Manager Modal
    if root.app-manager-open: Rectangle {
        width: 100%; height: 100%;
        border-radius: 8px;
        background: #00000048;
        TouchArea {
            clicked => {
                if !root.manager-confirm-open {
                    root.app-manager-open = false;
                }
            }
        }
    }
    if root.app-manager-open: GlassSurface {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: min(740px, root.width - 32px);
        height: min(480px, root.height - 32px);
        border-radius: 13px;
        dark: root.dark;
        fill: root.dark ? #2d2740 : #f4f1fa;
        edge: root.border;
        TouchArea { }
        VerticalLayout {
            padding: 16px;
            spacing: 12px;
            HorizontalLayout {
                height: 34px;
                spacing: 8px;
                Text {
                    horizontal-stretch: 1;
                    text: "应用与窗口管理";
                    color: root.ink;
                    font-size: 16px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                PanelButton {
                    width: 112px; dark: root.dark; primary: true; enabled: !root.busy;
                    text: "+ 添加应用";
                    clicked => {
                        root.app-manager-open = false;
                        root.manager-action("add_app", -1);
                    }
                }
                PanelButton {
                    width: 60px; dark: root.dark; quiet: true; text: "关闭";
                    clicked => { root.app-manager-open = false; root.manager-confirm-open = false; }
                }
            }

            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 14px;

                // Left Column: Applications List
                SectionCard {
                    width: 200px;
                    dark: root.dark;
                    VerticalLayout {
                        padding: 8px;
                        spacing: 6px;
                        Text { text: "已添加的应用"; color: root.muted; font-size: 12px; height: 18px; }
                        ScrollView {
                            vertical-stretch: 1;
                            content-width: self.visible-width;
                            VerticalLayout {
                                width: parent.visible-width - 8px;
                                spacing: 4px;
                                for app[idx] in root.managed-apps: Rectangle {
                                    height: 50px;
                                    border-radius: 8px;
                                    background: root.managed-app-index == idx ? root.selection
                                        : app-hit.has-hover ? root.paper : transparent;
                                    Rectangle {
                                        x: 1px; y: 8px; width: 2px; height: 34px;
                                        visible: root.managed-app-index == idx;
                                        border-radius: 1px; background: #c9ee46;
                                    }
                                    Text {
                                        x: 10px; y: 6px;
                                        width: parent.width - (app.active ? 54px : 16px);
                                        height: 20px;
                                        text: app.name;
                                        color: root.ink;
                                        font-size: 13px;
                                        font-weight: 600;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }
                                    if app.active: Rectangle {
                                        x: parent.width - 42px; y: 7px;
                                        width: 34px; height: 17px; border-radius: 4px;
                                        background: #c9ee46;
                                        Text {
                                            text: "当前"; color: #252338; font-size: 10px; font-weight: 700;
                                            horizontal-alignment: center; vertical-alignment: center;
                                        }
                                    }
                                    Text {
                                        x: 10px; y: 27px; width: parent.width - 16px; height: 17px;
                                        text: app.subtitle;
                                        color: root.muted;
                                        font-size: 11px;
                                        overflow: elide;
                                    }
                                    app-hit := TouchArea {
                                        enabled: !root.busy;
                                        clicked => { root.select-managed-app(idx); }
                                    }
                                }
                            }
                        }
                    }
                }

                // Right Column: Selected App Details
                if root.managed-apps.length == 0: SectionCard {
                    horizontal-stretch: 1;
                    dark: root.dark;
                    VerticalLayout {
                        alignment: center;
                        spacing: 8px;
                        Text {
                            text: "尚未添加任何目标应用";
                            color: root.ink; font-size: 14px; horizontal-alignment: center;
                        }
                        Text {
                            text: "点击右上角「+ 添加应用」在屏幕上点选一个目标窗口。";
                            color: root.muted; font-size: 12px; horizontal-alignment: center;
                        }
                    }
                }
                if root.managed-apps.length > 0 && root.managed-app-index >= 0 && root.managed-app-index < root.managed-apps.length: ScrollView {
                    horizontal-stretch: 1;
                    content-width: self.visible-width;
                    VerticalLayout {
                        width: parent.visible-width - 18px;
                        spacing: 12px;

                        // Selected App Header Card
                        SectionCard {
                            dark: root.dark;
                            HorizontalLayout {
                                padding: 12px;
                                spacing: 10px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 3px;
                                    Text {
                                        text: root.managed-apps[root.managed-app-index].name;
                                        color: root.ink; font-size: 15px; font-weight: 600; overflow: elide;
                                    }
                                    Text {
                                        text: root.managed-apps[root.managed-app-index].active
                                            ? "当前正在编辑此应用的遮盖配置"
                                            : "点击右侧按钮切换到此应用";
                                        color: root.muted; font-size: 12px;
                                    }
                                }
                                if !root.managed-apps[root.managed-app-index].active: PanelButton {
                                    width: 116px; dark: root.dark; primary: true; enabled: !root.busy;
                                    text: "切换至此应用";
                                    clicked => { root.manager-action("switch_app", -1); }
                                }
                            }
                        }

                        // Section 1: Running Windows
                        SectionCard {
                            dark: root.dark;
                            VerticalLayout {
                                padding: 12px;
                                spacing: 8px;
                                Text { text: "正在运行的窗口"; color: root.ink; font-size: 13px; font-weight: 600; }
                                if root.managed-windows.length == 0: Text {
                                    text: "当前未检测到该应用的运行窗口。";
                                    color: root.muted; font-size: 12px;
                                }
                                for win[widx] in root.managed-windows: Rectangle {
                                    height: 42px;
                                    border-radius: 8px;
                                    background: root.dark ? #362f4b : #f3effa;
                                    HorizontalLayout {
                                        padding-left: 10px; padding-right: 6px; padding-top: 4px; padding-bottom: 4px;
                                        spacing: 8px;
                                        Text {
                                            horizontal-stretch: 1;
                                            text: win.title;
                                            color: root.ink; font-size: 12px;
                                            vertical-alignment: center; overflow: elide;
                                        }
                                        Text {
                                            text: win.profile-label;
                                            color: win.bound ? (root.dark ? #c9ee46 : #5a7300) : root.muted;
                                            font-size: 11px;
                                            vertical-alignment: center;
                                        }
                                        if !win.bound: PanelButton {
                                            width: 64px; dark: root.dark; enabled: !root.busy;
                                            text: "切换";
                                            clicked => { root.manager-action("switch_window", widx); }
                                        }
                                        if win.has-profile: PanelButton {
                                            width: 84px; dark: root.dark; danger: true; enabled: !root.busy;
                                            text: "重置配置";
                                            clicked => {
                                                root.manager-confirm-title = "重置窗口「" + win.title + "」的独立配置？";
                                                root.manager-confirm-detail = "重置后该窗口将恢复使用应用的默认共享配置。";
                                                root.manager-confirm-kind = "delete_window_profile";
                                                root.manager-confirm-item = widx;
                                                root.manager-confirm-open = true;
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Section 2: Saved Window Profiles (Archives)
                        SectionCard {
                            dark: root.dark;
                            VerticalLayout {
                                padding: 12px;
                                spacing: 8px;
                                Text { text: "已保存的窗口配置"; color: root.ink; font-size: 13px; font-weight: 600; }
                                if root.managed-profiles.length == 0: Text {
                                    text: "暂无独立保存的窗口配置（所有窗口默认共享同一套应用配置）。";
                                    color: root.muted; font-size: 12px; wrap: word-wrap;
                                }
                                for prof[pidx] in root.managed-profiles: Rectangle {
                                    height: 42px;
                                    border-radius: 8px;
                                    background: root.dark ? #362f4b : #f3effa;
                                    HorizontalLayout {
                                        padding-left: 10px; padding-right: 6px; padding-top: 4px; padding-bottom: 4px;
                                        spacing: 8px;
                                        Text {
                                            horizontal-stretch: 1;
                                            text: prof.title;
                                            color: root.ink; font-size: 12px;
                                            vertical-alignment: center; overflow: elide;
                                        }
                                        if prof.can-apply: PanelButton {
                                            width: 64px; dark: root.dark; enabled: !root.busy;
                                            text: "应用";
                                            clicked => { root.manager-action("apply_profile", pidx); }
                                        }
                                        if prof.can-delete: PanelButton {
                                            width: 64px; dark: root.dark; danger: true; enabled: !root.busy;
                                            text: "删除";
                                            clicked => {
                                                root.manager-confirm-title = "删除已保存的配置「" + prof.title + "」？";
                                                root.manager-confirm-detail = "删除后无法恢复该窗口配置下的独立区域。";
                                                root.manager-confirm-kind = "delete_saved_profile";
                                                root.manager-confirm-item = pidx;
                                                root.manager-confirm-open = true;
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Section 3: App-Level Danger Zone
                        if root.managed-apps[root.managed-app-index].can-detach || root.managed-apps[root.managed-app-index].can-delete: SectionCard {
                            dark: root.dark;
                            VerticalLayout {
                                padding: 12px;
                                spacing: 8px;
                                Text { text: "移除与清理"; color: root.dark ? #ff808d : #b32140; font-size: 13px; font-weight: 600; }
                                if root.managed-apps[root.managed-app-index].can-detach: HorizontalLayout {
                                    height: 34px;
                                    spacing: 8px;
                                    Text {
                                        horizontal-stretch: 1;
                                        text: "停止关联此应用（保留本地配置）";
                                        color: root.muted; font-size: 12px; vertical-alignment: center;
                                    }
                                    PanelButton {
                                        width: 92px; dark: root.dark; enabled: !root.busy;
                                        text: "停止关联";
                                        clicked => {
                                            root.manager-confirm-title = "停止关联「" + root.managed-apps[root.managed-app-index].name + "」？";
                                            root.manager-confirm-detail = "已保存的遮盖区域与配置会保留在本地，随时可重新添加。";
                                            root.manager-confirm-kind = "detach_app";
                                            root.manager-confirm-item = -1;
                                            root.manager-confirm-open = true;
                                        }
                                    }
                                }
                                if root.managed-apps[root.managed-app-index].can-delete: HorizontalLayout {
                                    height: 34px;
                                    spacing: 8px;
                                    Text {
                                        horizontal-stretch: 1;
                                        text: "永久删除应用及其全部遮盖与窗口配置";
                                        color: root.muted; font-size: 12px; vertical-alignment: center;
                                    }
                                    PanelButton {
                                        width: 92px; dark: root.dark; danger: true; enabled: !root.busy;
                                        text: "彻底删除";
                                        clicked => {
                                            root.manager-confirm-title = "彻底删除「" + root.managed-apps[root.managed-app-index].name + "」及全部配置？";
                                            root.manager-confirm-detail = "该应用下的所有遮盖区域与窗口配置将被永久删除。";
                                            root.manager-confirm-kind = "delete_app";
                                            root.manager-confirm-item = -1;
                                            root.manager-confirm-open = true;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // Confirmation Modal inside App Manager
        if root.manager-confirm-open: Rectangle {
            width: 100%; height: 100%;
            border-radius: 13px;
            background: #00000055;
            TouchArea { clicked => { root.manager-confirm-open = false; } }
            GlassSurface {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 340px;
                height: 136px;
                border-radius: 11px;
                dark: root.dark;
                fill: root.paper;
                edge: root.border;
                VerticalLayout {
                    padding: 14px;
                    spacing: 8px;
                    Text {
                        text: root.manager-confirm-title;
                        color: root.ink; font-size: 13px; font-weight: 600;
                        wrap: word-wrap;
                    }
                    Text {
                        vertical-stretch: 1;
                        text: root.manager-confirm-detail;
                        color: root.muted; font-size: 12px;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        height: 32px;
                        spacing: 8px;
                        PanelButton {
                            dark: root.dark; text: "取消";
                            clicked => { root.manager-confirm-open = false; }
                        }
                        PanelButton {
                            dark: root.dark; danger: true; enabled: !root.busy;
                            text: "确认执行";
                            clicked => {
                                root.manager-confirm-open = false;
                                root.manager-action(root.manager-confirm-kind, root.manager-confirm-item);
                            }
                        }
                    }
                }
            }
        }
    }

    // Settings & Help Modal
    if root.settings-open: Rectangle {
        width: 100%; height: 100%;
        border-radius: 8px;
        background: #00000048;
        TouchArea { clicked => { root.hotkey-recording = false; root.settings-open = false; } }
    }
    if root.settings-open: GlassSurface {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: 520px;
        height: 430px;
        border-radius: 12px;
        dark: root.dark;
        fill: root.dark ? #302a43 : #f5f2fa;
        edge: root.border;
        TouchArea { }
        VerticalLayout {
            padding: 16px;
            spacing: 12px;
            HorizontalLayout {
                height: 32px;
                spacing: 8px;
                Text {
                    text: "设置与帮助";
                    color: root.ink; font-size: 16px; font-weight: 600; vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                SegmentedControl {
                    width: 222px;
                    choices: ["常规", "使用教程", "关于"];
                    current: root.settings-tab;
                    dark: root.dark;
                    selected(idx) => {
                        root.hotkey-recording = false;
                        root.settings-tab = idx;
                    }
                }
                PanelButton {
                    width: 52px; dark: root.dark; quiet: true; text: "关闭";
                    clicked => { root.hotkey-recording = false; root.settings-open = false; }
                }
            }
            if root.settings-tab == 0: ScrollView {
                vertical-stretch: 1;
                content-width: self.visible-width;
                VerticalLayout {
                    width: parent.visible-width - 14px;
                    spacing: 10px;
                    SectionCard {
                        dark: root.dark;
                        VerticalLayout {
                            padding: 12px;
                            spacing: 10px;
                            HorizontalLayout {
                                height: 28px; spacing: 8px;
                                Text { text: "全局呼出快捷键"; color: root.ink; font-size: 13px; font-weight: 600; vertical-alignment: center; }
                                Rectangle { horizontal-stretch: 1; }
                                Text {
                                    color: !root.hotkey-ok && root.hotkey-text != "None" ? (root.dark ? #ff808d : #b32140) : root.muted;
                                    font-size: 12px; vertical-alignment: center;
                                    text: root.hotkey-text == "None" ? "已关闭" : root.hotkey-ok ? root.hotkey-text : root.hotkey-text + "（被占用）";
                                }
                            }
                            HorizontalLayout {
                                height: 32px; spacing: 6px;
                                PanelButton {
                                    horizontal-stretch: 1; dark: root.dark;
                                    primary: root.hotkey-text == "Ctrl+Alt+O";
                                    text: "Ctrl+Alt+O";
                                    clicked => { root.hotkey-recording = false; root.set-hotkey("Ctrl+Alt+O"); }
                                }
                                PanelButton {
                                    horizontal-stretch: 1; dark: root.dark;
                                    primary: root.hotkey-text == "Alt+Shift+O";
                                    text: "Alt+Shift+O";
                                    clicked => { root.hotkey-recording = false; root.set-hotkey("Alt+Shift+O"); }
                                }
                                PanelButton {
                                    horizontal-stretch: 1; dark: root.dark;
                                    primary: root.hotkey-text == "Ctrl+Shift+O";
                                    text: "Ctrl+Shift+O";
                                    clicked => { root.hotkey-recording = false; root.set-hotkey("Ctrl+Shift+O"); }
                                }
                                PanelButton {
                                    width: 58px; dark: root.dark;
                                    primary: root.hotkey-text == "None";
                                    text: "关闭";
                                    clicked => { root.hotkey-recording = false; root.set-hotkey("None"); }
                                }
                            }
                            HorizontalLayout {
                                height: 32px; spacing: 8px;
                                PanelButton {
                                    horizontal-stretch: 1; dark: root.dark;
                                    active: root.hotkey-recording;
                                    text: root.hotkey-recording ? "请按下组合键（如 Ctrl+Alt+P，Esc 取消）…" : "自定义按键录制";
                                    clicked => {
                                        root.hotkey-recording = !root.hotkey-recording;
                                        if root.hotkey-recording { hotkey-capture.focus(); }
                                    }
                                }
                                hotkey-capture := FocusScope {
                                    width: 1px; height: 1px;
                                    key-pressed(event) => {
                                        if !root.hotkey-recording { return reject; }
                                        if event.text == Key.Escape {
                                            root.hotkey-recording = false;
                                            return accept;
                                        }
                                        if (event.modifiers.control || event.modifiers.alt || event.modifiers.shift) && event.text != "" {
                                            root.hotkey-recording = false;
                                            root.set-hotkey(
                                                (event.modifiers.control ? "Ctrl+" : "")
                                                + (event.modifiers.alt ? "Alt+" : "")
                                                + (event.modifiers.shift ? "Shift+" : "")
                                                + event.text
                                            );
                                            return accept;
                                        }
                                        return accept;
                                    }
                                }
                            }
                        }
                    }
                    SectionCard {
                        dark: root.dark;
                        VerticalLayout {
                            padding: 12px;
                            spacing: 10px;
                            HorizontalLayout {
                                height: 30px; spacing: 8px;
                                Text { width: 88px; text: "开机自启"; color: root.ink; font-size: 13px; vertical-alignment: center; }
                                Text { horizontal-stretch: 1; color: root.muted; font-size: 12px; vertical-alignment: center; text: root.startup-enabled ? "登录 Windows 后自动运行" : "手动启动"; }
                                ToggleSwitch {
                                    y: 4px; dark: root.dark; checked: root.startup-enabled; enabled: !root.busy;
                                    accessible-label: "开机自启";
                                    clicked => { root.toggle-startup(); }
                                }
                            }
                            HorizontalLayout {
                                height: 32px; spacing: 8px;
                                Text { width: 88px; text: "主题模式"; color: root.ink; font-size: 13px; vertical-alignment: center; }
                                SegmentedControl {
                                    horizontal-stretch: 1;
                                    choices: ["跟随系统", "浅色", "深色"];
                                    current: root.theme-mode;
                                    dark: root.dark;
                                    selected(idx) => { root.set-theme-mode(idx); }
                                }
                            }
                            HorizontalLayout {
                                height: 32px; spacing: 8px;
                                Text { width: 88px; text: "本地数据"; color: root.ink; font-size: 13px; vertical-alignment: center; }
                                Text { horizontal-stretch: 1; color: root.muted; font-size: 12px; vertical-alignment: center; text: "配置与诊断日志目录"; }
                                PanelButton {
                                    width: 112px; dark: root.dark; text: "打开配置目录";
                                    clicked => { root.open-config-dir(); }
                                }
                            }
                        }
                    }
                }
            }
            if root.settings-tab == 1: ScrollView {
                vertical-stretch: 1;
                content-width: self.visible-width;
                VerticalLayout {
                    width: parent.visible-width - 14px;
                    spacing: 10px;
                    SectionCard {
                        dark: root.dark;
                        VerticalLayout {
                            padding: 12px; spacing: 6px;
                            Text { text: "1. 选择目标应用与窗口"; color: root.ink; font-size: 13px; font-weight: 600; }
                            Text { text: "点击顶部应用选择器可点选任意桌面窗口或切换已保存的应用；支持为同一应用的不同窗口分别保存遮盖配置。"; color: root.muted; font-size: 12px; wrap: word-wrap; }
                        }
                    }
                    SectionCard {
                        dark: root.dark;
                        VerticalLayout {
                            padding: 12px; spacing: 6px;
                            Text { text: "2. 创建与调整遮盖区域"; color: root.ink; font-size: 13px; font-weight: 600; }
                            Text { text: "点击左侧「新建」或「连选」在目标窗口直接框选区域；支持隐藏/显示、复制区域（Ctrl+D）、复制/粘贴样式与撤销重做（Ctrl+Z / Ctrl+Y）。"; color: root.muted; font-size: 12px; wrap: word-wrap; }
                        }
                    }
                    SectionCard {
                        dark: root.dark;
                        VerticalLayout {
                            padding: 12px; spacing: 6px;
                            Text { text: "3. 固定定位 vs 视觉追踪"; color: root.ink; font-size: 13px; font-weight: 600; }
                            Text { text: "固定定位随窗口边缘/中心缩放；视觉追踪可锁定界面局部特征或边界，在侧栏折叠、滚动或重开窗口后自动找回位置。"; color: root.muted; font-size: 12px; wrap: word-wrap; }
                        }
                    }
                    SectionCard {
                        dark: root.dark;
                        VerticalLayout {
                            padding: 12px; spacing: 6px;
                            Text { text: "4. 常用快捷键"; color: root.ink; font-size: 13px; font-weight: 600; }
                            Text { text: "全局呼出/恢复编辑器：可在「常规」中修改（默认 Ctrl+Alt+O）；切换区域：Alt+↑ / Alt+↓；复制区域：Ctrl+D；撤销/重做：Ctrl+Z / Ctrl+Y。"; color: root.muted; font-size: 12px; wrap: word-wrap; }
                        }
                    }
                }
            }
            if root.settings-tab == 2: VerticalLayout {
                vertical-stretch: 1;
                alignment: center;
                spacing: 12px;
                HorizontalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text { text: "Its"; font-family: "Segoe UI"; font-size: 26px; font-weight: 700; color: root.ink; vertical-alignment: center; }
                    Rectangle {
                        width: 28px; height: 28px; y: 4px;
                        Path {
                            width: 28px; height: 28px; viewbox-width: 24; viewbox-height: 24;
                            fill: #ff9bb3;
                            commands: "M 3 10 L 1 4 L 7 6 Z M 11 6 L 16 3 L 15 9 Z";
                        }
                        Rectangle { x: 2px; y: 6px; width: 16px; height: 16px; border-radius: 8px; background: #ff9bb3; }
                        Rectangle { x: 7px; y: 6px; width: 20px; height: 20px; border-radius: 10px; background: root.dark ? #302a43 : #f5f2fa; }
                        Rectangle { x: 8px; y: 7px; width: 18px; height: 18px; border-radius: 9px; border-width: 3.2px; border-color: #c9ee46; background: transparent; }
                    }
                    Text { text: "verlay"; font-family: "Segoe UI"; font-size: 26px; font-weight: 700; color: root.ink; vertical-alignment: center; }
                }
                Text {
                    text: "就是遮 · 轻量桌面窗口局部遮盖与视觉追踪工具";
                    color: root.muted; font-size: 13px; horizontal-alignment: center;
                }
                SectionCard {
                    dark: root.dark;
                    VerticalLayout {
                        padding: 14px;
                        spacing: 8px;
                        HorizontalLayout {
                            Text { text: "当前版本"; color: root.muted; font-size: 12px; width: 72px; }
                            Text { text: root.app-version; color: root.ink; font-size: 12px; font-weight: 600; horizontal-stretch: 1; }
                        }
                        HorizontalLayout {
                            Text { text: "作者"; color: root.muted; font-size: 12px; width: 72px; }
                            Text { text: "Natsuaki-forever"; color: root.ink; font-size: 12px; font-weight: 600; horizontal-stretch: 1; }
                        }
                        HorizontalLayout {
                            Text { text: "GitHub"; color: root.muted; font-size: 12px; width: 72px; }
                            Text { text: "github.com/Natsuaki-forever/ItsOverlay"; color: root.ink; font-size: 12px; horizontal-stretch: 1; overflow: elide; }
                        }
                    }
                }
                HorizontalLayout {
                    alignment: center;
                    PanelButton {
                        width: 170px; dark: root.dark; primary: true; text: "打开 GitHub 仓库";
                        clicked => { root.open-repo-url(); }
                    }
                }
            }
        }
    }
    }
}
