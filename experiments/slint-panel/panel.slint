import { Button, ComboBox, ListView, Palette, ScrollView, Slider } from "std-widgets.slint";

component PanelButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> active;
    in property <bool> primary;
    in property <bool> tab;
    in property <bool> selector;
    in property <bool> quiet;
    in property <bool> menu-row;
    in property <length> menu-indent: 0px;
    in property <bool> current;
    in property <bool> danger;
    in property <string> icon;
    in property <bool> dark;
    property <bool> pointer-focused;
    callback clicked();
    min-height: 32px;
    border-radius: 8px;
    background: root.primary ? #c9ee46
        : root.current ? (root.dark ? #463c57 : #e8e1f3)
        : (root.tab && root.active) || ((root.tab || root.quiet) && !area.has-hover) ? transparent
        : root.dark ? (area.has-hover ? #443a5e : #332d47)
        : (area.has-hover ? #e9e3f5 : #f7f4fc);
    border-width: focus.has-focus && !root.tab ? 1px : 0px;
    border-color: root.dark ? #d0bdf5 : #7463a0;
    forward-focus: focus;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    focus := FocusScope {
        enabled: root.enabled;
        focus-changed-event => {
            if !self.has-focus { root.pointer-focused = false; }
        }
        key-pressed(event) => {
            root.pointer-focused = false;
            if event.text == Key.Return || event.text == " " {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    area := TouchArea {
        enabled: root.enabled;
        clicked => { root.pointer-focused = true; focus.focus(); root.clicked(); }
    }
    Text {
        x: root.selector ? 43px : root.menu-row ? root.menu-indent + 10px : root.icon != "" ? 23px : 4px;
        width: parent.width - self.x - (root.selector ? 25px : root.menu-row ? 45px : 4px);
        height: parent.height;
        text: root.text;
        color: !root.enabled ? #8a8299 : root.danger ? (root.dark ? #ff808d : #b32140)
            : root.primary || !root.dark ? #252338 : #f3eff9;
        font-size: root.tab ? 14px : 13px;
        font-weight: root.primary || root.active ? 600 : 400;
        overflow: elide;
        horizontal-alignment: root.selector || root.menu-row ? left : center;
        vertical-alignment: center;
    }
    if root.icon != "": Rectangle {
        x: 7px; y: (parent.height - self.height) / 2;
        width: 14px; height: 14px; border-radius: 4px;
        background: root.icon == "add" ? #c9ee46 : transparent;
        Path {
            x: 2px; y: 2px; width: 10px; height: 10px;
            stroke-width: 1.45px;
            stroke: !root.enabled ? #8a8299 : root.danger ? (root.dark ? #ff808d : #b32140)
                : root.icon == "add" || !root.dark ? #252338 : #f3eff9;
            commands: root.icon == "add" ? "M 2 5 H 8 M 5 2 V 8" : root.icon == "frame"
                ? "M 0 3 V 0 H 3 M 7 0 H 10 V 3 M 10 7 V 10 H 7 M 3 10 H 0 V 7"
                : "M 1 2 H 9 M 4 0 H 6 M 2 4 V 9 H 8 V 4";
        }
    }
    if root.tab && (root.active || (focus.has-focus && !root.pointer-focused)): Rectangle {
        width: 32px;
        height: 4px;
        x: (parent.width - self.width) / 2;
        y: parent.height - 2px;
        border-radius: 2px;
        background: root.active ? #c9ee46 : root.dark ? #b1a2d5 : #7463a0;
    }
}

export struct Setting {
    key: string,
    label: string,
    value: string,
    choices: [string],
    choice: int,
    action: bool,
    swatch: color,
    has-swatch: bool,
    toggle: bool,
    number: float,
    minimum: float,
    maximum: float,
    step: float,
    section: int,
    geometry-pair: int,
    geometry-tail: bool,
}

export struct TargetRow {
    title: string,
    group: string,
    kind: string,
    current: bool,
    parent: int,
}

component GlassSurface inherits Rectangle {
    in property <bool> dark;
    in property <color> fill;
    in property <color> edge;
    border-width: 1px;
    border-color: root.edge;
    background: root.fill;
    drop-shadow-color: root.dark ? #160e24a3 : #30204d30;
    drop-shadow-offset-y: 3px;
    drop-shadow-blur: 6px;
    Rectangle {
        x: 1px; y: 1px;
        width: parent.width - 2px;
        height: parent.height / 3;
        border-top-left-radius: root.border-radius - 1px;
        border-top-right-radius: root.border-radius - 1px;
        background: root.dark
            ? @linear-gradient(180deg, #655c7c24 0%, #655c7c00 100%)
            : @linear-gradient(180deg, #ffffff24 0%, #ffffff00 100%);
    }
}

component SurfaceShadow inherits Rectangle {
    in property <bool> dark;
    border-radius: 11px;
    background: transparent;
    for offset in [4, 3, 2, 1]: Rectangle {
        x: -offset * 1px;
        y: 3px - offset * 1px;
        width: parent.width + offset * 2px;
        height: parent.height + offset * 2px;
        border-radius: 11px + offset * 1px;
        background: root.dark ? #160e240b : #30204d06;
    }
}

component PanelTextField inherits Rectangle {
    in property <bool> dark;
    in property <bool> enabled: true;
    in property <bool> multiline;
    in property <bool> has-swatch;
    in property <color> swatch;
    in-out property <string> text <=> input.text;
    out property <bool> editing: input.has-focus;
    callback accepted(string);
    horizontal-stretch: 1;
    border-radius: 7px;
    background: root.multiline ? transparent : root.dark ? #302a43 : #f5f2fa;
    border-width: root.multiline ? 0px : 1px;
    border-color: input.has-focus ? (root.dark ? #b1a2d5 : #7463a0) : (root.dark ? #6e6488 : #c6bed8);
    forward-focus: input;
    if root.has-swatch: Rectangle {
        x: 10px; y: (parent.height - self.height) / 2;
        width: 13px; height: 13px;
        background: root.swatch; border-radius: 2px;
        border-width: 1px; border-color: #7c718530;
    }
    ContextMenuArea {
        enabled: root.enabled;
        Menu {
            MenuItem { title: "剪切"; enabled: root.text != ""; activated => { input.cut(); } }
            MenuItem { title: "复制"; enabled: root.text != ""; activated => { input.copy(); } }
            MenuItem { title: "粘贴"; activated => { input.paste(); } }
            MenuItem { title: "全选"; enabled: root.text != ""; activated => { input.select-all(); } }
        }
        scroll := ScrollView {
            x: root.has-swatch ? 30px : 10px;
            y: root.multiline ? 6px : 1px;
            width: parent.width - self.x - 8px;
            height: parent.height - 2 * self.y;
            content-width: self.visible-width;
            content-height: root.multiline ? max(self.visible-height, input.preferred-height) : self.visible-height;
            input := TextInput {
                width: scroll.visible-width;
                height: scroll.content-height;
                enabled: root.enabled;
                color: root.enabled ? (root.dark ? #f3eff9 : #252338) : #8a8299;
                font-size: root.multiline ? 24px : 14px;
                single-line: !root.multiline;
                wrap: root.multiline ? word-wrap : no-wrap;
                vertical-alignment: root.multiline ? top : center;
                selection-background-color: #c9ee46;
                selection-foreground-color: #252338;
                page-height: scroll.visible-height;
                cursor-position-changed(pos) => {
                    if root.multiline && pos.y + scroll.content-y < 0px {
                        scroll.content-y = -pos.y;
                    } else if root.multiline && pos.y + scroll.content-y > scroll.visible-height - 29px {
                        scroll.content-y = max(scroll.visible-height - self.height, scroll.visible-height - pos.y - 29px);
                    }
                }
                accepted => { root.accepted(self.text); }
            }
        }
    }
}

component PanelCombo inherits Rectangle {
    in property <[string]> model;
    in-out property <int> current-index <=> combo.current-index;
    in property <bool> enabled: true;
    in property <bool> dark;
    in property <bool> editable;
    in property <string> value;
    callback selected(int);
    callback accepted(string);
    border-radius: 7px;
    border-width: 1px;
    border-color: combo.has-focus ? (root.dark ? #b1a2d5 : #7463a0) : (root.dark ? #6e6488 : #c6bed8);
    background: root.dark ? #302a43 : #f5f2fa;
    min-width: 0px;
    horizontal-stretch: 1;
    forward-focus: combo;
    if !root.editable: Text {
        x: 9px; width: parent.width - 34px; height: parent.height;
        color: !root.enabled ? #8a8299 : root.dark ? #f3eff9 : #252338;
        font-size: 14px; overflow: elide; vertical-alignment: center;
        text: root.current-index >= 0 && root.current-index < root.model.length ? root.model[root.current-index] : "";
    }
    Path {
        x: parent.width - 19px; y: (parent.height - 6px) / 2;
        width: 7px; height: 6px; stroke-width: 1.4px;
        stroke: root.dark ? #f3eff9 : #252338; commands: "M 0 1 L 3.5 4.5 L 7 1";
    }
    combo := ComboBox {
        width: parent.width; height: parent.height; opacity: 0;
        model: root.model; enabled: root.enabled;
        selected => { root.selected(self.current-index); }
    }
    if root.editable: PanelTextField {
        x: 1px; y: 1px;
        width: parent.width - 25px; height: parent.height - 2px;
        dark: root.dark; enabled: root.enabled; text: root.value;
        border-width: 0px;
        accepted(value) => { root.accepted(value); }
    }
}

component SettingControl inherits HorizontalLayout {
    in property <Setting> setting;
    in property <bool> dark;
    in property <bool> busy;
    in property <bool> hide-label;
    in property <length> label-width: 110px;
    in property <bool> stepper;
    in property <color> ink;
    callback edit(string, string, int);
    spacing: 8px;
    if !root.setting.action && !root.hide-label: Text {
        width: root.label-width;
        text: root.setting.label; color: root.ink; font-size: 13px; vertical-alignment: center;
    }
    if root.setting.action: PanelButton {
        dark: root.dark; text: root.setting.label; enabled: !root.busy;
        clicked => { root.edit(root.setting.key, "", -1); }
    }
    if !root.setting.action && root.setting.toggle: Rectangle {
        width: 40px;
        horizontal-stretch: 0;
        PanelButton {
            x: 0px; y: (parent.height - self.height) / 2;
            width: 40px; height: 22px; min-height: 22px;
            border-radius: 11px;
            background: root.setting.choice == 1 ? #c9ee46 : root.dark ? #7a7089 : #79738a;
            enabled: !root.busy;
            accessible-label: root.setting.label;
            clicked => { root.edit(root.setting.key, "", root.setting.choice == 1 ? 0 : 1); }
            Rectangle {
                x: root.setting.choice == 1 ? parent.width - 18px : 4px;
                y: 4px; width: 14px; height: 14px; border-radius: 7px;
                background: root.setting.choice == 1 ? #252338 : #ffffff;
            }
        }
    }
    if root.setting.toggle: Rectangle { horizontal-stretch: 1; }
    if !root.setting.action && !root.setting.toggle && root.setting.choices.length > 0: PanelCombo {
        min-width: 0px; preferred-width: 69px;
        model: root.setting.choices; current-index: root.setting.choice; enabled: !root.busy; dark: root.dark;
        editable: root.setting.key == "font";
        value: root.setting.value;
        selected(index) => {
            if root.setting.key == "font" {
                if index >= 0 && index < root.setting.choices.length {
                    root.edit("font", root.setting.choices[index], -1);
                }
            } else { root.edit(root.setting.key, "", index); }
        }
        accepted(value) => { root.edit(root.setting.key, value, -1); }
    }
    if root.setting.maximum > root.setting.minimum: range-track := Rectangle {
        min-width: 50px;
        horizontal-stretch: 1;
        property <length> progress: (self.width - 14px) * clamp((control.value - root.setting.minimum) / (root.setting.maximum - root.setting.minimum), 0, 1);
        Rectangle {
            x: 6px; y: (parent.height - 4px) / 2;
            width: parent.width - 12px; height: 4px; border-radius: 2px;
            background: root.dark ? #67607c : #bcb7cf;
            Rectangle { x: 0px; y: 0px; width: range-track.progress; height: parent.height; border-radius: 2px; background: #c9ee46; }
        }
        Rectangle {
            x: parent.progress; y: (parent.height - 14px) / 2;
            width: 14px; height: 14px; border-radius: 7px;
            background: #c9ee46;
            border-width: control.has-focus ? 1px : 0px;
            border-color: root.ink;
        }
        control := Slider {
            width: parent.width; height: parent.height;
            opacity: 0;
            enabled: !root.busy;
            minimum: root.setting.minimum; maximum: root.setting.maximum;
            step: root.setting.step; value: root.setting.number;
            accessible-label: root.setting.label;
            released(value) => { root.edit(root.setting.key, "" + round(value * 10) / 10, -1); }
        }
    }
    if !root.setting.action && root.setting.choices.length == 0: PanelTextField {
        min-width: 0px; preferred-width: 60px;
        max-width: root.setting.maximum > root.setting.minimum ? 85px : 2000px;
        horizontal-stretch: root.setting.maximum > root.setting.minimum ? 0 : 1;
        dark: root.dark; text: root.setting.value; enabled: !root.busy;
        has-swatch: root.setting.has-swatch; swatch: root.setting.swatch;
        accepted(value) => { root.edit(root.setting.key, value, -1); }
    }
    if root.stepper: PanelButton {
        width: 27px; dark: root.dark; text: "−"; enabled: !root.busy;
        clicked => { root.edit(root.setting.key, "", -2); }
    }
    if root.stepper: PanelButton {
        width: 27px; dark: root.dark; text: "+"; enabled: !root.busy;
        clicked => { root.edit(root.setting.key, "", -3); }
    }
}

component TypographyField inherits VerticalLayout {
    in property <Setting> setting;
    in property <bool> dark;
    in property <bool> busy;
    in property <color> ink;
    in property <string> label: root.setting.label;
    callback edit(string, string, int);
    spacing: 5px;
    Text { text: root.label; color: root.ink; font-size: 13px; height: 19px; }
    if root.setting.key == "bold": PanelButton {
        height: 38px;
        text: "B"; dark: root.dark; primary: root.setting.choice == 1; enabled: !root.busy;
        clicked => { root.edit(root.setting.key, "", root.setting.choice == 1 ? 0 : 1); }
    }
    if root.setting.key != "bold": SettingControl {
        height: 38px;
        setting: root.setting; dark: root.dark; busy: root.busy; ink: root.ink; hide-label: true;
        edit(key, value, index) => { root.edit(key, value, index); }
    }
}

export component Panel inherits Window {
    title: "ItsOverlay";
    no-frame: true;
    preferred-width: 976px;
    preferred-height: 577px;
    min-width: 640px;
    min-height: 525px;
    background: root.dark ? #272338 : #eeecf6;
    default-font-family: "Microsoft YaHei UI";

    in property <[string]> regions;
    in property <[string]> region-details;
    in property <[bool]> region-scoped;
    in property <int> selected: -1;
    in property <bool> busy: true;
    in-out property <string> draft;
    in property <string> status: "正在连接遮盖引擎…";
    in property <string> position-status;
    in property <bool> visual-position;
    in property <bool> cover-outside;
    in property <bool> calibration-open;
    in property <bool> calibration-has-reference;
    in property <string> search-distance;
    in property <bool> retry-calibration;
    in property <bool> can-resume-calibration;
    property <int> reference-kind: 0;
    property <int> advanced-section: 0;
    in property <bool> can-select-target: false;
    in property <bool> can-draw: false;
    in property <int> engine-pid: 0;
    in property <string> canvas-mode: "idle";
    in property <string> loaded-text;
    in property <string> target-name: "选择应用";
    in property <[TargetRow]> targets;
    in-out property <string> expanded-group;
    in-out property <int> expanded-action: -1;
    in-out property <bool> expanded-management;
    property <length> target-menu-height: 210px;
    in-out property <bool> choosing-target: false;
    in-out property <bool> dark: false;
    init => { Palette.color-scheme = ColorScheme.light; }
    changed dark => { Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light; }
    in-out property <bool> confirm-delete: false;
    in-out property <bool> confirm-clear: false;
    property <bool> region-menu-open;
    property <length> region-menu-y;
    in property <bool> managing-targets;
    in-out property <int> pending-target: -1;
    in-out property <int> page: 0;
    in property <[Setting]> settings;
    property <color> ink: root.dark ? #f3eff9 : #252338;
    property <color> muted: root.dark ? #c3bdd6 : #57536e;
    property <bool> compact-form: root.width < 830px;
    property <color> paper: root.dark ? #302a43 : #f5f2fa;
    property <color> border: root.dark ? #746e8d : #bcb7cf;
    property <color> selection: root.dark ? #423854 : #f5f1fb;
    callback choose(int);
    callback open-targets();
    callback manage-targets();
    callback choose-target(int);
    callback set-canvas-mode(string);
    callback set-page(int);
    callback set-option(string, string, int);
    callback apply();
    callback finish();

    Rectangle {
        clip: true;
        border-radius: 15px;
        border-width: 1px;
        border-color: root.border;
        Rectangle {
            x: -parent.width * 0.36; y: -parent.height * 0.46;
            width: parent.width * 1.16; height: parent.height * 1.36;
            background: root.dark
                ? @radial-gradient(circle, #3c30517d 0%, #3c305100 48%)
                : @radial-gradient(circle, #d8cfee7d 0%, #d8cfee00 48%);
        }
        Rectangle {
            x: parent.width * 0.22; y: parent.height * 0.06;
            width: parent.width * 1.42; height: parent.height * 1.72;
            background: root.dark
                ? @radial-gradient(circle, #3c3051b9 0%, #3c305100 48%)
                : @radial-gradient(circle, #d8cfeeb9 0%, #d8cfee00 48%);
        }
    }
    SurfaceShadow {
        x: rail-surface.x + body.x;
        y: rail-surface.y + body.y;
        width: rail-surface.width; height: rail-surface.height;
        dark: root.dark;
    }
    SurfaceShadow {
        x: work-surface.x + work.x + body.x;
        y: work-surface.y + work.y + body.y;
        width: work-surface.width; height: work-surface.height;
        dark: root.dark;
    }
    VerticalLayout {
        padding-left: 23px;
        padding-right: 23px;
        padding-top: 14px;
        padding-bottom: 11px;
        spacing: 15px;
        HorizontalLayout {
            height: 44px;
            spacing: 5px;
            Text { width: 90px; text: "Overlay"; font-family: "Segoe UI"; font-size: 23px; font-weight: 700; color: root.ink; vertical-alignment: center; }
            PanelButton {
                width: 290px;
                dark: root.dark;
                selector: true;
                text: root.target-name;
                enabled: root.can-select-target && !root.busy;
                clicked => {
                    if root.choosing-target { root.choosing-target = false; root.pending-target = -1; }
                    else { root.open-targets(); }
                }
                Rectangle {
                    x: 0px;
                    y: 0px;
                    width: 59px;
                    height: parent.height;
                    clip: true;
                    Rectangle {
                        x: 0px;
                        y: 0px;
                        width: parent.width + 13px;
                        height: parent.height;
                        border-radius: 9px;
                        border-width: 2px;
                        border-color: #c9ee46;
                    }
                }
                Rectangle { x: 4px; y: 6px; width: 30px; height: 30px; border-radius: 7px; background: #c9ee46;
                    for corner in [0, 1, 2, 3]: Rectangle {
                        x: mod(corner, 2) == 0 ? 8px : 17px;
                        y: corner < 2 ? 8px : 17px;
                        width: 5px; height: 5px;
                        Rectangle { width: 5px; height: 2px; y: corner < 2 ? 0px : 3px; background: #252338; }
                        Rectangle { width: 2px; height: 5px; x: mod(corner, 2) == 0 ? 0px : 3px; background: #252338; }
                    }
                }
                Path {
                    x: parent.width - 20px; y: 20px; width: 8px; height: 5px;
                    stroke: root.ink; stroke-width: 1.5px;
                    commands: "M 0 0 L 4 4 L 8 0";
                }
            }
            Rectangle { horizontal-stretch: 1; }
            PanelButton {
                width: 32px;
                dark: root.dark;
                quiet: true;
                accessible-label: root.dark ? "切换浅色主题" : "切换深色主题";
                clicked => { root.dark = !root.dark; }
                Path {
                    x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                    width: 18px; height: 18px; stroke: root.ink; stroke-width: 1.6px;
                    commands: root.dark
                        ? "M 14.9 12.6 A 7 7 0 0 1 5.4 3.1 A 7.4 7.4 0 1 0 14.9 12.6 Z"
                        : "M 12.5 9 A 3.5 3.5 0 1 0 5.5 9 A 3.5 3.5 0 1 0 12.5 9 Z M 9 1 V 3 M 9 15 V 17 M 1 9 H 3 M 15 9 H 17 M 3.3 3.3 L 4.7 4.7 M 13.3 13.3 L 14.7 14.7 M 3.3 14.7 L 4.7 13.3 M 13.3 4.7 L 14.7 3.3";
                }
            }
            PanelButton {
                width: 32px;
                dark: root.dark;
                quiet: true;
                accessible-label: "关闭面板";
                enabled: !root.busy;
                clicked => { root.finish(); }
                Path {
                    x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                    width: 18px; height: 18px; stroke: root.ink; stroke-width: 1.6px;
                    commands: "M 3 3 L 15 15 M 15 3 L 3 15";
                }
            }
        }
        body := HorizontalLayout {
            spacing: 23px;
            vertical-stretch: 1;
            rail-surface := GlassSurface {
                width: 220px;
                dark: root.dark;
                fill: root.dark ? #2d26407d : #e4ddf07a;
                border-radius: 11px;
                edge: root.border;
                VerticalLayout {
                    padding: 10px;
                    spacing: 8px;
                    Text { text: "遮盖区域"; color: root.muted; font-size: 13px; height: 20px; }
                    HorizontalLayout {
                        height: 36px;
                        spacing: 4px;
                        PanelButton {
                            text: root.canvas-mode == "once" ? "取消" : "新建";
                            icon: "add";
                            enabled: root.can-draw && !root.busy && root.canvas-mode != "free";
                            dark: root.dark;
                            clicked => { root.set-canvas-mode(root.canvas-mode == "once" ? "idle" : "once"); }
                        }
                        PanelButton {
                            text: root.canvas-mode == "free" ? "结束" : "全窗";
                            icon: "frame";
                            enabled: root.can-draw && !root.busy;
                            dark: root.dark;
                            clicked => { root.set-canvas-mode(root.canvas-mode == "free" ? "idle" : "free"); }
                        }
                        PanelButton {
                            text: "清空"; icon: "delete";
                            danger: true;
                            enabled: root.regions.length > 0 && !root.busy && root.canvas-mode == "idle";
                            dark: root.dark;
                            clicked => { root.confirm-clear = true; }
                        }
                    }
                    ListView {
                        vertical-stretch: 1;
                        for title[index] in root.regions: Rectangle {
                            height: 55px;
                            border-radius: 8px;
                            background: root.selected == index ? root.selection : hit.has-hover ? root.paper : transparent;
                            Rectangle {
                                x: 1px; y: 8px; width: 2px; height: 34px;
                                visible: root.selected == index;
                                border-radius: 1px; background: #c9ee46;
                            }
                            Rectangle {
                                x: 7px; y: 8px; width: 22px; height: 22px; border-radius: 5px;
                                background: root.selected == index ? #c9ee46 : root.paper;
                                if !root.region-scoped[index]: Rectangle {
                                    x: 8px; y: 5px; width: 10px; height: 8px;
                                    border-width: 1px; border-color: root.selected == index ? #252338 : root.ink;
                                }
                                Rectangle {
                                    x: 4px; y: 8px; width: 12px; height: 9px;
                                    background: parent.background;
                                    border-width: 1px; border-color: root.selected == index ? #252338 : root.ink;
                                }
                            }
                            Text { x: 34px; y: 4px; width: parent.width - 70px; height: 24px; vertical-alignment: center;
                                overflow: elide; text: title; color: root.ink; font-size: 14px; font-weight: 600; }
                            Text { x: 34px; y: 26px; height: 19px; text: root.region-details[index]; color: root.muted; font-size: 12px; }
                            hit := TouchArea {
                                width: parent.width - 32px;
                                enabled: !root.busy && root.canvas-mode == "idle";
                                clicked => { root.confirm-delete = false; root.choose(index); }
                            }
                            menu-button := PanelButton {
                                x: parent.width - 31px; y: 8px; width: 26px; height: 31px; dark: root.dark; tab: true; text: "···";
                                accessible-label: "区域操作";
                                enabled: !root.busy && root.canvas-mode == "idle";
                                clicked => {
                                    if root.selected != index { root.choose(index); }
                                    root.region-menu-y = menu-button.absolute-position.y + menu-button.height;
                                    root.region-menu-open = true;
                                }
                            }
                        }
                    }
                }
            }
            work := VerticalLayout {
                horizontal-stretch: 1;
                spacing: 7px;
                Text { text: root.selected >= 0 ? root.regions[root.selected] : "选择覆盖区域";
                    height: 33px; font-size: 22px; font-weight: 400; color: root.ink; overflow: elide; vertical-alignment: center; }
                HorizontalLayout {
                    height: 36px;
                    spacing: 3px;
                    alignment: start;
                    for label[index] in ["文字", "位置", "背景", "效果"]: PanelButton {
                        width: 51px; dark: root.dark; tab: true;
                        text: label;
                        active: index == 1 ? root.page == 1 || root.page == 4
                            : index == 3 ? root.page == 3 || root.page == 5 || root.page == 6
                            : root.page == index;
                        enabled: !root.busy;
                        clicked => { root.set-page(index); }
                    }
                }
                work-surface := GlassSurface {
                    vertical-stretch: 1;
                    dark: root.dark;
                    border-radius: 11px;
                    edge: root.border;
                    fill: root.dark ? #382f4ca0 : #fffaff7d;
                    VerticalLayout {
                        padding: 18px;
                        spacing: 8px;
                        if root.page == 4: HorizontalLayout {
                            height: 34px;
                            alignment: start;
                            PanelButton { width: 110px; dark: root.dark; text: "‹  返回位置";
                                clicked => { root.set-page(1); } }
                        }
                        if root.page == 1: ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                width: parent.visible-width;
                                spacing: 8px;
                                if root.selected >= 0: HorizontalLayout {
                                    height: 33px;
                                    spacing: 7px;
                                    Text { width: 54px; text: "参考内容"; color: root.ink; font-size: 13px; vertical-alignment: center; }
                                    PanelCombo {
                                        dark: root.dark;
                                        model: ["文字 / 图案位置（无需边框）", "完整边框"];
                                        current-index <=> root.reference-kind;
                                        enabled: !root.busy && !root.calibration-open;
                                    }
                                }
                                if root.selected >= 0: HorizontalLayout {
                                    height: 32px; spacing: 5px;
                                    PanelButton {
                                        width: 135px; dark: root.dark; primary: true; enabled: !root.busy;
                                        text: root.calibration-open ? "重选参考区域…"
                                            : root.canvas-mode == "cover_draft" ? "保存遮盖位置"
                                            : root.cover-outside ? "将遮盖移回窗口…" : "选择参考区域…";
                                        clicked => { root.set-option(root.calibration-open ? "pick_calibration_reference"
                                            : root.canvas-mode == "cover_draft" ? "commit_cover_drag"
                                            : root.cover-outside ? "begin_cover_drag"
                                            : root.reference-kind == 0 ? "begin_features" : "begin_boundary", "", -1); }
                                    }
                                    if root.calibration-open && root.calibration-has-reference: PanelButton {
                                        width: 75px; dark: root.dark; text: "确认校准"; enabled: !root.busy;
                                        clicked => { root.set-option("confirm_calibration", "", -1); }
                                    }
                                    if root.calibration-open: PanelButton {
                                        width: 75px; dark: root.dark; text: "取消校准"; enabled: !root.busy;
                                        clicked => { root.set-option("cancel_calibration", "", -1); }
                                    }
                                    if root.canvas-mode == "cover_draft": PanelButton {
                                        width: 75px; dark: root.dark; text: "取消移动"; enabled: !root.busy;
                                        clicked => { root.set-canvas-mode("idle"); }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    if !root.calibration-open && root.canvas-mode != "cover_draft": PanelButton { width: 132px; dark: root.dark; text: "›  高级定位设置";
                                        clicked => { root.advanced-section = 0; root.set-page(4); } }
                                }
                                if root.selected >= 0: Text {
                                    height: 23px; font-size: 12px; color: root.muted; overflow: elide;
                                    text: root.calibration-open ? "校准预览 · 确认后保存"
                                        : root.canvas-mode == "cover_draft" ? "确认新位置后保存，参考区域继续沿用。"
                                        : root.cover-outside ? "已找到参考内容。遮盖超出窗口，请拖回后保存。"
                                        : root.visual-position ? "视觉定位已启用，可重新选择参考区域。"
                                        : "当前使用窗口锚定。选好参考区域后可启用视觉定位。";
                                }
                                if root.settings.length == 6 && root.settings[0].key == "x": VerticalLayout {
                                    spacing: 7px;
                                    for row in [0, 2]: HorizontalLayout {
                                        height: 33px;
                                        spacing: 8px;
                                        for column in [0, 1]: SettingControl {
                                            setting: root.settings[row + column];
                                            horizontal-stretch: 1; label-width: 28px; stepper: true;
                                            dark: root.dark; busy: root.busy; ink: root.ink;
                                            edit(key, value, index) => { root.set-option(key, value, index); }
                                        }
                                    }
                                    for index in [4, 5]: SettingControl {
                                        height: 33px; label-width: 54px;
                                        setting: root.settings[index];
                                        dark: root.dark; busy: root.busy; ink: root.ink;
                                        edit(key, value, index) => { root.set-option(key, value, index); }
                                    }
                                }
                            }
                        }
                        if root.page == 4: HorizontalLayout {
                            height: 33px; spacing: 8px; alignment: start;
                            for title[index] in ["校准与检查", "遮盖关系", "参考框微调"]: PanelButton {
                                min-width: 82px; preferred-width: 132px; max-width: 132px;
                                text: title; dark: root.dark; tab: true;
                                active: root.advanced-section == index;
                                clicked => { root.advanced-section = index; }
                            }
                        }
                        if root.page == 3 || root.page == 5 || root.page == 6: HorizontalLayout {
                            height: 32px; spacing: 5px; alignment: start;
                            for label[index] in ["滚动", "描边", "发光"]: PanelButton {
                                width: 48px; dark: root.dark; tab: true;
                                text: label;
                                active: root.page == (index == 0 ? 3 : index + 4);
                                enabled: !root.busy;
                                clicked => { root.set-page(index == 0 ? 3 : index + 4); }
                            }
                        }
                        if root.page == 0: ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                width: parent.visible-width;
                                spacing: 12px;
                                Text { height: 20px; text: "遮盖文字"; color: root.ink; font-size: 13px; }
                                cover-editor := PanelTextField {
                                    height: 94px;
                                    multiline: true;
                                    dark: root.dark;
                                    enabled: root.selected >= 0 && !root.busy && root.canvas-mode == "idle";
                                    text <=> root.draft;
                                }
                                if root.settings.length == 8: Rectangle {
                                    height: 1px;
                                    background: cover-editor.editing ? (root.dark ? #b1a2d5 : #7463a0) : root.border;
                                }
                                if root.settings.length == 8: HorizontalLayout {
                                    spacing: 8px;
                                    for field in (root.compact-form ? [0, 1, 2, 3] : [0, 1, 2, 3, 6, 7]): TypographyField {
                                        setting: root.settings[field];
                                        label: field == 7 || field == 2 ? "" : field == 3 ? "文字对齐" : self.setting.label;
                                        horizontal-stretch: field == 0 ? 3 : field == 3 || field == 6 ? 1 : 0;
                                        min-width: field == 1 ? 53px : field == 2 ? 56px : field == 7 ? 48px : 65px;
                                        dark: root.dark; busy: root.busy; ink: root.ink;
                                        edit(key, value, index) => { root.set-option(key, value, index); }
                                    }
                                }
                                if root.settings.length == 8 && root.compact-form: HorizontalLayout {
                                    alignment: start;
                                    spacing: 8px;
                                    for field in [6, 7]: TypographyField {
                                        width: field == 6 ? 118px : 54px;
                                        setting: root.settings[field];
                                        label: field == 7 ? "" : self.setting.label;
                                        dark: root.dark; busy: root.busy; ink: root.ink;
                                        edit(key, value, index) => { root.set-option(key, value, index); }
                                    }
                                }
                                if root.settings.length == 8: HorizontalLayout {
                                    spacing: 10px;
                                    alignment: start;
                                    for field in [5, 4]: TypographyField {
                                        width: 118px;
                                        setting: root.settings[field];
                                        dark: root.dark; busy: root.busy; ink: root.ink;
                                        edit(key, value, index) => { root.set-option(key, value, index); }
                                    }
                                }
                            }
                        }
                        if root.page == 2 && root.settings.length == 3 && root.settings[0].key == "opacity": VerticalLayout {
                            vertical-stretch: 1;
                            alignment: start;
                            spacing: 12px;
                            SettingControl {
                                height: 37px; label-width: 83px; setting: root.settings[0];
                                dark: root.dark; busy: root.busy; ink: root.ink;
                                edit(key, value, index) => { root.set-option(key, value, index); }
                            }
                            HorizontalLayout {
                                height: 38px; spacing: 8px;
                                SettingControl {
                                    horizontal-stretch: 1; label-width: 83px; setting: root.settings[1];
                                    dark: root.dark; busy: root.busy; ink: root.ink;
                                    edit(key, value, index) => { root.set-option(key, value, index); }
                                }
                                PanelButton {
                                    width: 50px; dark: root.dark; text: "取色"; enabled: !root.busy;
                                    clicked => { root.set-option("pick_background", "", -1); }
                                }
                            }
                        }
                        if root.page == 4: ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                width: parent.visible-width - 9px;
                                if root.advanced-section == 0 && root.selected >= 0: VerticalLayout {
                                    spacing: 8px;
                                    HorizontalLayout {
                                        height: 32px; spacing: 8px;
                                        Text { width: 132px; text: "参考内容"; color: root.ink; font-size: 13px; vertical-alignment: center; }
                                        PanelCombo {
                                            dark: root.dark;
                                            model: ["文字 / 图案位置（无需边框）", "完整边框"];
                                            current-index <=> root.reference-kind;
                                            enabled: !root.busy && !root.calibration-open;
                                        }
                                    }
                                    if root.visual-position && root.search-distance != "" && !root.calibration-open: HorizontalLayout {
                                        height: 32px; spacing: 8px; alignment: start;
                                        Text { width: 132px; text: "找回距离 (DIP)"; color: root.ink; font-size: 13px; vertical-alignment: center; }
                                        distance := PanelTextField {
                                            width: 75px; dark: root.dark;
                                            text: root.search-distance; enabled: !root.busy;
                                            accepted(value) => { root.set-option("search", value, -1); }
                                        }
                                        PanelButton {
                                            width: 100px; dark: root.dark; text: "保存找回距离";
                                            enabled: !root.busy && distance.text != root.search-distance;
                                            clicked => { root.set-option("search", distance.text, -1); }
                                        }
                                    }
                                    VerticalLayout {
                                        height: 32px;
                                        spacing: 0px;
                                        for entry in root.settings: Rectangle {
                                            height: entry.key == "interval" ? 32px : 0px;
                                            if entry.key == "interval": SettingControl {
                                                width: parent.width; height: 32px; label-width: 132px;
                                                setting: entry; dark: root.dark; busy: root.busy; ink: root.ink;
                                                edit(key, value, index) => { root.set-option(key, value, index); }
                                            }
                                        }
                                    }
                                    HorizontalLayout {
                                        height: 32px; spacing: 6px; alignment: start;
                                        PanelButton {
                                            width: 128px; dark: root.dark; primary: true; enabled: !root.busy;
                                            text: root.calibration-open ? "重选参考区域…" : "选择参考区域…";
                                            clicked => { root.set-option(root.calibration-open ? "pick_calibration_reference"
                                                : root.reference-kind == 0 ? "begin_features" : "begin_boundary", "", -1); }
                                        }
                                        if root.calibration-open && root.calibration-has-reference: PanelButton {
                                            width: 71px; dark: root.dark; text: "确认校准"; enabled: !root.busy;
                                            clicked => { root.set-option("confirm_calibration", "", -1); }
                                        }
                                        if root.calibration-open: PanelButton {
                                            width: 71px; dark: root.dark; text: "取消校准"; enabled: !root.busy;
                                            clicked => { root.set-option("cancel_calibration", "", -1); }
                                        }
                                        if root.visual-position && !root.calibration-open: PanelButton {
                                            width: 69px; dark: root.dark; text: "重新定位"; enabled: !root.busy;
                                            clicked => { root.set-option("refresh_visual", "", -1); }
                                        }
                                        if root.visual-position && !root.calibration-open: PanelButton {
                                            width: 91px; dark: root.dark; text: "改用窗口锚定"; enabled: !root.busy;
                                            clicked => { root.set-option("anchor", "", -1); }
                                        }
                                    }
                                    if !root.calibration-open && (root.retry-calibration || (!root.visual-position && root.can-resume-calibration)): HorizontalLayout {
                                        height: 32px; spacing: 8px; alignment: start;
                                        if root.retry-calibration: PanelButton {
                                            width: 90px; dark: root.dark; text: "重试校准";
                                            clicked => { root.set-option("retry_calibration", "", -1); }
                                        }
                                        if !root.visual-position && root.can-resume-calibration: PanelButton {
                                            width: 110px; dark: root.dark; text: "恢复视觉校准";
                                            clicked => { root.set-option("resume", "", -1); }
                                        }
                                    }
                                }
                                for entry in root.settings: Rectangle {
                                    property <bool> shown: root.advanced-section != 0 && entry.section == root.advanced-section && !entry.geometry-tail;
                                    height: shown ? 39px : 0px;
                                    if shown && entry.action: PanelButton {
                                        x: 0px; y: 0px; width: 135px; height: 32px;
                                        dark: root.dark; text: entry.label; enabled: !root.busy;
                                        clicked => { root.set-option(entry.key, "", -1); }
                                    }
                                    if shown && !entry.action && entry.geometry-pair < 0: SettingControl {
                                        width: parent.width; height: 32px;
                                        setting: entry; dark: root.dark; busy: root.busy; ink: root.ink;
                                        edit(key, value, index) => { root.set-option(key, value, index); }
                                    }
                                    if shown && entry.geometry-pair >= 0: HorizontalLayout {
                                        width: parent.width; height: 32px;
                                        x: 0px; y: 0px;
                                        spacing: 9px;
                                        for field in [entry, root.settings[entry.geometry-pair]]: SettingControl {
                                            setting: field; dark: root.dark; busy: root.busy; ink: root.ink;
                                            label-width: root.compact-form ? 38px : 58px; stepper: true;
                                            edit(key, value, index) => { root.set-option(key, value, index); }
                                        }
                                    }
                                }
                                if root.advanced-section != 0 && !root.calibration-has-reference && !root.visual-position: VerticalLayout {
                                    spacing: 10px;
                                    HorizontalLayout {
                                        alignment: start; height: 32px;
                                        PanelButton {
                                            width: 135px; dark: root.dark; primary: true; text: "选择参考区域…";
                                            enabled: !root.busy;
                                            clicked => { root.set-option(root.calibration-open ? "pick_calibration_reference" : root.reference-kind == 0 ? "begin_features" : "begin_boundary", "", -1); }
                                        }
                                    }
                                    Text {
                                        height: 22px; color: root.muted; font-size: 12px;
                                        text: root.advanced-section == 1 ? "选择参考区域后，即可调整遮盖关系。" : "选择参考区域后，即可微调参考框。";
                                    }
                                }
                            }
                        }
                        if root.page == 3 || root.page == 5 || root.page == 6: ListView {
                            vertical-stretch: 1;
                            for entry in root.settings: Rectangle {
                                height: 39px;
                                SettingControl {
                                    width: parent.width; height: 32px;
                                    label-width: root.page == 3 ? 78px : 98px;
                                    setting: entry; dark: root.dark; busy: root.busy; ink: root.ink;
                                    edit(key, value, index) => { root.set-option(key, value, index); }
                                }
                            }
                        }
                    }
                }
            }
        }
        HorizontalLayout {
            height: 44px;
            spacing: 8px;
            Text { text: root.loaded-text == root.draft ? "已保存" : "未保存"; width: 49px; color: root.muted; font-size: 12px; vertical-alignment: center; }
            Text { text: root.status == "" ? root.position-status : root.status; color: root.muted; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
            if root.loaded-text != root.draft: PanelButton { width: 76px; dark: root.dark; text: "应用"; enabled: !root.busy; clicked => { root.apply(); } }
            PanelButton { width: 78px; dark: root.dark; text: "完成"; primary: true; enabled: !root.busy; clicked => { root.finish(); } }
        }
    }
    if root.region-menu-open || root.confirm-clear || root.confirm-delete: TouchArea {
        clicked => { root.region-menu-open = false; root.confirm-clear = false; root.confirm-delete = false; }
    }
    if root.region-menu-open: GlassSurface {
        x: 36px; y: min(root.region-menu-y + 2px, root.height - 128px);
        width: 195px; height: 116px; border-radius: 10px;
        dark: root.dark; fill: root.paper; edge: root.border;
        VerticalLayout {
            padding: 6px; spacing: 2px;
            PanelButton {
                dark: root.dark; quiet: true; menu-row: true; text: "跟随应用";
                enabled: !root.busy; current: root.selected >= 0 && !root.region-scoped[root.selected];
                clicked => { root.region-menu-open = false; root.set-option("scope_app", "", -1); }
            }
            PanelButton {
                dark: root.dark; quiet: true; menu-row: true; text: "只在指定窗口显示…";
                enabled: !root.busy; current: root.selected >= 0 && root.region-scoped[root.selected];
                clicked => { root.region-menu-open = false; root.set-option("scope_window", "", -1); }
            }
            PanelButton {
                dark: root.dark; quiet: true; menu-row: true; text: "删除区域…"; danger: true;
                enabled: !root.busy;
                clicked => { root.region-menu-open = false; root.confirm-delete = true; }
            }
        }
    }
    if root.confirm-clear || root.confirm-delete: GlassSurface {
        x: (root.width - self.width) / 2; y: (root.height - self.height) / 2;
        width: 290px; height: 106px; border-radius: 11px;
        dark: root.dark; fill: root.paper; edge: root.border;
        VerticalLayout {
            padding: 14px; spacing: 8px;
            Text {
                color: root.ink; horizontal-alignment: center;
                text: root.confirm-clear ? "清空当前显示的遮盖区域？" : "删除选中的遮盖区域？";
            }
            HorizontalLayout {
                height: 32px; spacing: 8px;
                PanelButton { dark: root.dark; text: "取消"; clicked => { root.confirm-delete = false; root.confirm-clear = false; } }
                PanelButton {
                    dark: root.dark; danger: true; enabled: !root.busy;
                    text: root.confirm-clear ? "确认清空" : "确认删除";
                    clicked => {
                        root.set-option(root.confirm-clear ? "clear" : "delete", "", -1);
                        root.confirm-delete = false; root.confirm-clear = false;
                    }
                }
            }
        }
    }
    if root.choosing-target: TouchArea {
        clicked => { root.choosing-target = false; root.pending-target = -1; }
    }
    if root.choosing-target: GlassSurface {
        x: root.managing-targets ? root.width - 315px : 118px;
        y: 62px;
        width: 290px;
        height: root.pending-target >= 0 ? 135px : min(root.target-menu-height, root.height - 84px);
        border-radius: 11px;
        dark: root.dark;
        fill: root.dark ? #302a43 : #f5f2fa;
        edge: root.border;
        if root.pending-target < 0: ScrollView {
            x: 6px; y: 6px; width: parent.width - 12px; height: parent.height - 12px;
            content-width: self.visible-width;
            menu-content := VerticalLayout {
                width: parent.visible-width;
                changed preferred-height => { root.target-menu-height = self.preferred-height + 12px; }
                spacing: 1px;
                for entry[index] in root.targets: VerticalLayout {
                    property <bool> is-app: entry.kind == "app" || entry.kind == "app-direct";
                    property <bool> action-row: entry.kind == "window-action" || entry.kind == "archive-action" || entry.kind == "archive-delete";
                    property <bool> management-row: entry.kind == "detach" || entry.kind == "delete";
                    property <bool> show-row: is-app || ((entry.group == "" || entry.group == root.expanded-group)
                        && (!action-row || entry.parent == root.expanded-action)
                        && (!management-row || root.expanded-management));
                    height: show-row ? (entry.kind == "add" ? 36px : 35px) : 0px;
                    if show-row: VerticalLayout {
                        spacing: 0px;
                        if entry.kind == "add": Rectangle { height: 1px; background: root.border; opacity: 0.45; }
                        Rectangle {
                            height: 35px;
                            property <bool> can-expand: entry.kind == "archive"
                                || (entry.kind == "window" && index + 1 < root.targets.length
                                    && root.targets[index + 1].kind == "window-action");
                            PanelButton {
                                width: parent.width; height: parent.height;
                                text: entry.kind == "add" ? "+  " + entry.title : entry.title;
                                menu-row: true; quiet: true; dark: root.dark;
                                active: is-app; current: entry.current && !is-app;
                                menu-indent: action-row ? 28px : entry.group != "" && !is-app ? 24px : 0px;
                                danger: entry.kind == "delete" || entry.kind == "window-action" || entry.kind == "archive-delete";
                                enabled: !root.busy && entry.kind != "waiting";
                                clicked => {
                                    if entry.kind == "app" {
                                        root.expanded-group = root.expanded-group == entry.group ? "" : entry.group;
                                        root.expanded-action = -1;
                                    } else if entry.kind == "manage" {
                                        root.expanded-management = !root.expanded-management;
                                    } else if entry.kind == "archive" {
                                        root.expanded-action = root.expanded-action == index ? -1 : index;
                                    } else if self.danger || entry.kind == "detach" {
                                        root.pending-target = index;
                                    } else {
                                        root.choose-target(index);
                                    }
                                }
                            }
                            if entry.kind == "window" || entry.kind == "archive": Rectangle {
                                x: 9px; y: 9px; height: 17px; width: 18px;
                                border-radius: 4px;
                                background: entry.current ? #c9ee46 : root.selection;
                                Path {
                                    x: 4px; y: 4px; width: 10px; height: 9px; stroke: entry.current ? #252338 : root.ink;
                                    stroke-width: 1.25px;
                                    commands: entry.kind == "window" ? "M 0 0 H 10 V 9 H 0 Z M 0 3 H 10"
                                        : "M 0 2 H 10 V 9 H 0 Z M 1 0 H 9 M 3 5 H 7";
                                }
                            }
                            if entry.kind == "app" || entry.kind == "manage" || (entry.current && !is-app): Path {
                                x: parent.width - 21px; y: 14px; height: 8px; width: 9px;
                                stroke: root.ink; stroke-width: 1.5px;
                                commands: entry.kind == "manage" ? (root.expanded-management ? "M 0 6 L 4 2 L 8 6" : "M 2 0 L 6 4 L 2 8")
                                    : entry.kind == "app" ? (root.expanded-group == entry.group ? "M 0 6 L 4 2 L 8 6" : "M 0 2 L 4 6 L 8 2")
                                    : "M 0 4 L 3 7 L 9 0";
                            }
                            if can-expand: PanelButton {
                                x: parent.width - 59px; y: 1px; width: 28px; height: 33px;
                                text: "···"; dark: root.dark; quiet: true;
                                clicked => { root.expanded-action = root.expanded-action == index ? -1 : index; }
                            }
                        }
                    }
                }
            }
        }
        if root.pending-target >= 0: VerticalLayout {
            padding: 12px; spacing: 8px;
            Text { text: root.targets[root.pending-target].title; color: root.ink; overflow: elide; }
            Text { text: "确认执行此操作？"; color: root.muted; }
            HorizontalLayout {
                spacing: 8px;
                Button { text: "取消"; clicked => { root.pending-target = -1; } }
                Button { text: "确认"; clicked => { root.choose-target(root.pending-target); root.pending-target = -1; } }
            }
        }
    }
}
