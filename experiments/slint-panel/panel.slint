import { ComboBox, ListView, Palette, ScrollView, Slider } from "std-widgets.slint";

component PanelButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> active;
    in property <bool> primary;
    in property <bool> tab;
    in property <bool> selector;
    in property <bool> quiet;
    in property <bool> menu-row;
    in property <length> menu-indent: 0px;
    in property <bool> current;
    in property <bool> danger;
    in property <string> icon;
    in property <bool> dark;
    property <bool> pointer-focused;
    callback clicked();
    min-height: 32px;
    border-radius: 8px;
    background: root.primary ? #c9ee46
        : root.current ? (root.dark ? #463c57 : #e8e1f3)
        : (root.tab && root.active) || ((root.tab || root.quiet) && !area.has-hover) ? transparent
        : root.dark ? (area.has-hover ? #443a5e : #332d47)
        : (area.has-hover ? #e9e3f5 : #f7f4fc);
    border-width: focus.has-focus && !root.pointer-focused && !root.tab ? 1px : 0px;
    border-color: root.dark ? #d0bdf5 : #7463a0;
    forward-focus: focus;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    focus := FocusScope {
        enabled: root.enabled;
        focus-changed-event => {
            if !self.has-focus { root.pointer-focused = false; }
        }
        key-pressed(event) => {
            root.pointer-focused = false;
            if event.text == Key.Return || event.text == " " {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    area := TouchArea {
        enabled: root.enabled;
        clicked => { root.pointer-focused = true; focus.focus(); root.clicked(); }
    }
    Text {
        x: root.selector ? 43px : root.menu-row ? root.menu-indent + 10px : root.icon != "" ? 23px : 4px;
        width: parent.width - self.x - (root.selector ? 25px : root.menu-row ? 45px : 4px);
        height: parent.height;
        text: root.text;
        color: !root.enabled ? #8a8299 : root.danger ? (root.dark ? #ff808d : #b32140)
            : root.primary || !root.dark ? #252338 : #f3eff9;
        font-size: root.tab ? 14px : 13px;
        font-weight: root.primary || root.active ? 600 : 400;
        overflow: elide;
        horizontal-alignment: root.selector || root.menu-row ? left : center;
        vertical-alignment: center;
    }
    if root.icon != "": Rectangle {
        x: 7px; y: (parent.height - self.height) / 2;
        width: 14px; height: 14px; border-radius: 4px;
        background: root.icon == "add" ? #c9ee46 : transparent;
        Path {
            x: 2px; y: 2px; width: 10px; height: 10px;
            stroke-width: 1.45px;
            stroke: !root.enabled ? #8a8299 : root.danger ? (root.dark ? #ff808d : #b32140)
                : root.icon == "add" || !root.dark ? #252338 : #f3eff9;
            commands: root.icon == "add" ? "M 2 5 H 8 M 5 2 V 8" : root.icon == "frame"
                ? "M 0 3 V 0 H 3 M 7 0 H 10 V 3 M 10 7 V 10 H 7 M 3 10 H 0 V 7"
                : "M 1 2 H 9 M 4 0 H 6 M 2 4 V 9 H 8 V 4";
        }
    }
    if root.tab && (root.active || (focus.has-focus && !root.pointer-focused)): Rectangle {
        width: 42px;
        height: 4px;
        x: (parent.width - self.width) / 2;
        y: parent.height - 2px;
        border-radius: 2px;
        background: root.active ? #c9ee46 : root.dark ? #b1a2d5 : #7463a0;
    }
}

export struct Setting {
    key: string,
    label: string,
    value: string,
    choices: [string],
    choice: int,
    action: bool,
    swatch: color,
    has-swatch: bool,
    toggle: bool,
    number: float,
    minimum: float,
    maximum: float,
    step: float,
    section: int,
    geometry-pair: int,
    geometry-tail: bool,
}

export struct RegionItem {
    title: string,
    detail: string,
    scoped: bool,
    hidden: bool,
    bg: color,
    fg: color,
    status-kind: string,
}

export struct TargetRow {
    title: string,
    group: string,
    kind: string,
    current: bool,
    parent: int,
}

export struct ManagedAppItem {
    id: string,
    name: string,
    subtitle: string,
    active: bool,
    can-detach: bool,
    can-delete: bool,
}

export struct ManagedWindowItem {
    index: int,
    title: string,
    bound: bool,
    has-profile: bool,
    profile-label: string,
}

export struct ManagedProfileItem {
    id: string,
    title: string,
    can-apply: bool,
    target-window-title: string,
    can-delete: bool,
}

component GlassSurface inherits Rectangle {
    in property <bool> dark;
    in property <color> fill;
    in property <color> edge;
    border-width: 1px;
    border-color: root.edge;
    background: root.fill;
    drop-shadow-color: root.dark ? #160e24a3 : #30204d30;
    drop-shadow-offset-y: 3px;
    drop-shadow-blur: 6px;
    Rectangle {
        x: 1px; y: 1px;
        width: parent.width - 2px;
        height: parent.height / 3;
        border-top-left-radius: root.border-radius - 1px;
        border-top-right-radius: root.border-radius - 1px;
        background: root.dark
            ? @linear-gradient(180deg, #655c7c24 0%, #655c7c00 100%)
            : @linear-gradient(180deg, #ffffff24 0%, #ffffff00 100%);
    }
}

component SectionCard inherits Rectangle {
    in property <bool> dark;
    border-radius: 10px;
    border-width: 1px;
    border-color: root.dark ? #6e648860 : #c6bed870;
    background: root.dark ? #2d254278 : #ffffff92;
}

component SurfaceShadow inherits Rectangle {
    in property <bool> dark;
    border-radius: 11px;
    background: transparent;
    for offset in [4, 3, 2, 1]: Rectangle {
        x: -offset * 1px;
        y: 3px - offset * 1px;
        width: parent.width + offset * 2px;
        height: parent.height + offset * 2px;
        border-radius: 11px + offset * 1px;
        background: root.dark ? #160e240b : #30204d06;
    }
}

component ToggleSwitch inherits Rectangle {
    in property <bool> dark;
    in property <bool> checked;
    in property <bool> enabled: true;
    property <bool> pointer-focused;
    callback clicked();
    width: 40px;
    height: 22px;
    border-radius: 11px;
    background: root.checked ? #c9ee46 : root.dark ? #7a7089 : #79738a;
    border-width: focus.has-focus && !root.pointer-focused ? 1px : 0px;
    border-color: root.dark ? #d0bdf5 : #7463a0;
    forward-focus: focus;
    accessible-role: checkbox;
    accessible-checked: root.checked;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    focus := FocusScope {
        enabled: root.enabled;
        focus-changed-event => {
            if !self.has-focus { root.pointer-focused = false; }
        }
        key-pressed(event) => {
            root.pointer-focused = false;
            if event.text == Key.Return || event.text == " " {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    TouchArea {
        enabled: root.enabled;
        clicked => { root.pointer-focused = true; focus.focus(); root.clicked(); }
    }
    Rectangle {
        x: root.checked ? parent.width - 18px : 4px;
        y: 4px; width: 14px; height: 14px; border-radius: 7px;
        background: root.checked ? #252338 : #ffffff;
    }
}

component SegmentedControl inherits Rectangle {
    in property <[string]> choices;
    in property <int> current: 0;
    in property <bool> dark;
    in property <bool> enabled: true;
    callback selected(int);
    height: 32px;
    border-radius: 8px;
    border-width: 1px;
    border-color: root.dark ? #6e6488 : #c6bed8;
    background: root.dark ? #302a43 : #f5f2fa;
    HorizontalLayout {
        padding: 3px;
        spacing: 2px;
        for title[index] in root.choices: Rectangle {
            horizontal-stretch: 1;
            border-radius: 6px;
            background: root.current == index ? #c9ee46
                : seg-hit.has-hover ? (root.dark ? #443a5e : #e9e3f5) : transparent;
            seg-hit := TouchArea {
                enabled: root.enabled;
                clicked => { root.selected(index); }
            }
            Text {
                text: title;
                color: !root.enabled ? #8a8299
                    : root.current == index || !root.dark ? #252338 : #f3eff9;
                font-size: 13px;
                font-weight: root.current == index ? 600 : 400;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}

component ColorPresetStrip inherits HorizontalLayout {
    in property <[string]> hexes;
    in property <[color]> colors;
    in property <string> current;
    in property <bool> enabled: true;
    in property <bool> dark;
    callback picked(string);
    spacing: 5px;
    alignment: start;
    for swatch[index] in root.colors: Rectangle {
        width: 18px;
        height: 18px;
        y: (parent.height - self.height) / 2;
        border-radius: 5px;
        border-width: root.current == root.hexes[index] ? 2px : 1px;
        border-color: root.current == root.hexes[index] ? #c9ee46 : (root.dark ? #ffffff45 : #00000030);
        background: swatch;
        TouchArea {
            enabled: root.enabled;
            clicked => { root.picked(root.hexes[index]); }
        }
    }
}

component PanelTextField inherits Rectangle {
    in property <bool> dark;
    in property <bool> enabled: true;
    in property <bool> multiline;
    in property <bool> has-swatch;
    in property <color> swatch;
    in-out property <string> text <=> input.text;
    out property <bool> editing: input.has-focus;
    property <bool> dirty: false;
    callback accepted(string);
    callback edited(string);
    callback blurred(string);
    horizontal-stretch: 1;
    border-radius: 7px;
    background: root.multiline ? transparent : root.dark ? #302a43 : #f5f2fa;
    border-width: root.multiline ? 0px : 1px;
    border-color: input.has-focus ? (root.dark ? #b1a2d5 : #7463a0) : (root.dark ? #6e6488 : #c6bed8);
    forward-focus: input;
    if root.has-swatch: Rectangle {
        x: 10px; y: (parent.height - self.height) / 2;
        width: 13px; height: 13px;
        background: root.swatch; border-radius: 2px;
        border-width: 1px; border-color: #7c718530;
    }
    ContextMenuArea {
        enabled: root.enabled;
        Menu {
            MenuItem { title: "剪切"; enabled: root.text != ""; activated => { input.cut(); } }
            MenuItem { title: "复制"; enabled: root.text != ""; activated => { input.copy(); } }
            MenuItem { title: "粘贴"; activated => { input.paste(); } }
            MenuItem { title: "全选"; enabled: root.text != ""; activated => { input.select-all(); } }
        }
        scroll := ScrollView {
            x: root.has-swatch ? 30px : 10px;
            y: root.multiline ? 6px : 1px;
            width: parent.width - self.x - 8px;
            height: parent.height - 2 * self.y;
            content-width: self.visible-width;
            content-height: root.multiline ? max(self.visible-height, input.preferred-height) : self.visible-height;
            input := TextInput {
                width: scroll.visible-width;
                height: scroll.content-height;
                enabled: root.enabled;
                color: root.enabled ? (root.dark ? #f3eff9 : #252338) : #8a8299;
                font-size: root.multiline ? 24px : 14px;
                single-line: !root.multiline;
                wrap: root.multiline ? word-wrap : no-wrap;
                vertical-alignment: root.multiline ? top : center;
                selection-background-color: #c9ee46;
                selection-foreground-color: #252338;
                page-height: scroll.visible-height;
                cursor-position-changed(pos) => {
                    if root.multiline && pos.y + scroll.content-y < 0px {
                        scroll.content-y = -pos.y;
                    } else if root.multiline && pos.y + scroll.content-y > scroll.visible-height - 29px {
                        scroll.content-y = max(scroll.visible-height - self.height, scroll.visible-height - pos.y - 29px);
                    }
                }
                edited => {
                    root.dirty = true;
                    root.edited(self.text);
                }
                accepted => {
                    root.dirty = false;
                    root.accepted(self.text);
                }
                changed has-focus => {
                    if !self.has-focus {
                        if !root.multiline && root.dirty {
                            root.dirty = false;
                            root.accepted(self.text);
                        }
                        root.blurred(self.text);
                    }
                }
            }
        }
    }
}

component PanelCombo inherits Rectangle {
    in property <[string]> model;
    in-out property <int> current-index <=> combo.current-index;
    in property <bool> enabled: true;
    in property <bool> dark;
    in property <bool> editable;
    in property <string> value;
    callback selected(int);
    callback accepted(string);
    border-radius: 7px;
    border-width: 1px;
    border-color: combo.has-focus ? (root.dark ? #b1a2d5 : #7463a0) : (root.dark ? #6e6488 : #c6bed8);
    background: root.dark ? #302a43 : #f5f2fa;
    min-width: 0px;
    horizontal-stretch: 1;
    forward-focus: combo;
    if !root.editable: Text {
        x: 9px; width: parent.width - 34px; height: parent.height;
        color: !root.enabled ? #8a8299 : root.dark ? #f3eff9 : #252338;
        font-size: 14px; overflow: elide; vertical-alignment: center;
        text: root.current-index >= 0 && root.current-index < root.model.length ? root.model[root.current-index] : "";
    }
    Path {
        x: parent.width - 19px; y: (parent.height - 6px) / 2;
        width: 7px; height: 6px; stroke-width: 1.4px;
        stroke: root.dark ? #f3eff9 : #252338; commands: "M 0 1 L 3.5 4.5 L 7 1";
    }
    combo := ComboBox {
        width: parent.width; height: parent.height; opacity: 0;
        model: root.model; enabled: root.enabled;
        selected => { root.selected(self.current-index); }
    }
    if root.editable: PanelTextField {
        x: 1px; y: 1px;
        width: parent.width - 25px; height: parent.height - 2px;
        dark: root.dark; enabled: root.enabled; text: root.value;
        border-width: 0px;
        accepted(value) => { root.accepted(value); }
    }
}

component SettingControl inherits HorizontalLayout {
    in property <Setting> setting;
    in property <bool> dark;
    in property <bool> busy;
    in property <bool> hide-label;
    in property <length> label-width: 110px;
    in property <bool> stepper;
    in property <color> ink;
    property <bool> dragging: false;
    property <string> live-value: "";
    callback edit(string, string, int);
    callback preview(string, string);
    spacing: 8px;
    if !root.setting.action && !root.hide-label: Text {
        width: root.label-width;
        text: root.setting.label; color: root.ink; font-size: 13px; vertical-alignment: center;
    }
    if root.setting.action: PanelButton {
        dark: root.dark; text: root.setting.label; enabled: !root.busy;
        clicked => { root.edit(root.setting.key, "", -1); }
    }
    if !root.setting.action && root.setting.toggle: Rectangle {
        width: 40px;
        horizontal-stretch: 0;
        ToggleSwitch {
            x: 0px; y: (parent.height - self.height) / 2;
            dark: root.dark;
            checked: root.setting.choice == 1;
            enabled: !root.busy;
            accessible-label: root.setting.label;
            clicked => { root.edit(root.setting.key, "", root.setting.choice == 1 ? 0 : 1); }
        }
    }
    if root.setting.toggle: Rectangle { horizontal-stretch: 1; }
    if !root.setting.action && !root.setting.toggle && root.setting.choices.length > 0: PanelCombo {
        min-width: 0px; preferred-width: 69px;
        model: root.setting.choices; current-index: root.setting.choice; enabled: !root.busy; dark: root.dark;
        editable: root.setting.key == "font";
        value: root.setting.value;
        selected(index) => {
            if root.setting.key == "font" {
                if index >= 0 && index < root.setting.choices.length {
                    root.edit("font", root.setting.choices[index], -1);
                }
            } else { root.edit(root.setting.key, "", index); }
        }
        accepted(value) => { root.edit(root.setting.key, value, -1); }
    }
    if root.setting.maximum > root.setting.minimum: range-track := Rectangle {
        min-width: 50px;
        horizontal-stretch: 1;
        property <length> progress: (self.width - 14px) * clamp((control.value - root.setting.minimum) / (root.setting.maximum - root.setting.minimum), 0, 1);
        Rectangle {
            x: 6px; y: (parent.height - 4px) / 2;
            width: parent.width - 12px; height: 4px; border-radius: 2px;
            background: root.dark ? #67607c : #bcb7cf;
            Rectangle { x: 0px; y: 0px; width: range-track.progress; height: parent.height; border-radius: 2px; background: #c9ee46; }
        }
        Rectangle {
            x: parent.progress; y: (parent.height - 14px) / 2;
            width: 14px; height: 14px; border-radius: 7px;
            background: #c9ee46;
            border-width: 0px;
            border-color: root.ink;
        }
        control := Slider {
            width: parent.width; height: parent.height;
            opacity: 0;
            enabled: !root.busy;
            minimum: root.setting.minimum; maximum: root.setting.maximum;
            step: root.setting.step; value: root.setting.number;
            accessible-label: root.setting.label;
            changed(value) => {
                root.dragging = true;
                root.live-value = root.setting.step >= 1
                    ? "" + round(value)
                    : "" + round(value * 10) / 10;
                root.preview(root.setting.key, root.live-value);
            }
            released(value) => {
                root.dragging = false;
                root.edit(
                    root.setting.key,
                    root.setting.step >= 1 ? "" + round(value) : "" + round(value * 10) / 10,
                    -1
                );
            }
        }
    }
    if !root.setting.action && root.setting.choices.length == 0: PanelTextField {
        min-width: 0px; preferred-width: 60px;
        max-width: root.setting.maximum > root.setting.minimum ? 85px : 2000px;
        horizontal-stretch: root.setting.maximum > root.setting.minimum ? 0 : 1;
        dark: root.dark;
        text: root.dragging ? root.live-value : root.setting.value;
        enabled: !root.busy;
        has-swatch: root.setting.has-swatch; swatch: root.setting.swatch;
        accepted(value) => {
            root.dragging = false;
            root.edit(root.setting.key, value, -1);
        }
    }
    if root.stepper: PanelButton {
        width: 27px; dark: root.dark; text: "−"; enabled: !root.busy;
        clicked => { root.edit(root.setting.key, "", -2); }
    }
    if root.stepper: PanelButton {
        width: 27px; dark: root.dark; text: "+"; enabled: !root.busy;
        clicked => { root.edit(root.setting.key, "", -3); }
    }
}

component ColorSettingRow inherits HorizontalLayout {
    in property <string> label;
    in property <length> label-width: 64px;
    in property <Setting> setting;
    in property <[string]> preset-hexes;
    in property <[color]> preset-colors;
    in property <bool> show-eyedropper: false;
    in property <string> eyedropper-key: "";
    in property <bool> dark;
    in property <bool> busy;
    in property <color> ink;
    callback edit(string, string, int);
    callback open-picker(string, string, string, string);
    height: 32px;
    spacing: 8px;
    Text { width: root.label-width; text: root.label; color: root.ink; font-size: 13px; vertical-alignment: center; }
    Rectangle {
        width: 64px;
        height: 32px;
        border-radius: 7px;
        border-width: 1px;
        border-color: picker-hit.has-hover ? #c9ee46 : (root.dark ? #6e6488 : #c6bed8);
        background: root.dark ? (picker-hit.has-hover ? #443a5e : #302a43) : (picker-hit.has-hover ? #e9e3f5 : #f5f2fa);
        Rectangle {
            x: 6px; y: 6px; width: 20px; height: 20px; border-radius: 4px;
            background: root.setting.swatch;
            border-width: 1px;
            border-color: root.dark ? #ffffff45 : #00000030;
        }
        Text {
            x: 30px; width: 30px; height: parent.height;
            text: "选色";
            color: root.ink;
            font-size: 12px;
            vertical-alignment: center;
        }
        picker-hit := TouchArea {
            enabled: !root.busy;
            clicked => {
                root.open-picker(
                    root.setting.key,
                    root.label,
                    root.setting.value,
                    root.show-eyedropper ? root.eyedropper-key : ""
                );
            }
        }
    }
    PanelTextField {
        width: 86px; horizontal-stretch: 0;
        dark: root.dark; enabled: !root.busy;
        text: root.setting.value;
        has-swatch: false; swatch: root.setting.swatch;
        accepted(value) => { root.edit(root.setting.key, value, -1); }
    }
    if root.show-eyedropper: PanelButton {
        width: 46px; dark: root.dark; text: "取色"; enabled: !root.busy;
        clicked => { root.edit(root.eyedropper-key, "", -1); }
    }
    ColorPresetStrip {
        hexes: root.preset-hexes;
        colors: root.preset-colors;
        current: root.setting.value;
        enabled: !root.busy;
        dark: root.dark;
        picked(hex) => { root.edit(root.setting.key, hex, -1); }
    }
}

export component Panel inherits Window {
    title: "ItsOverlay - 就是遮";
    no-frame: true;
    preferred-width: 976px;
    preferred-height: 577px;
    min-width: 640px;
    min-height: 525px;
    background: root.dark ? #272338 : #eeecf6;
    default-font-family: "Microsoft YaHei UI";

    in property <[RegionItem]> region-items;
    in property <int> selected: -1;
    in property <bool> busy: true;
    in-out property <string> draft;
    in property <string> status: "正在连接遮盖引擎…";
    in property <string> position-status;
    in property <string> visual-status-detail;
    in property <bool> visual-position;
    in property <bool> cover-outside;
    in property <bool> calibration-open;
    in property <bool> calibration-has-reference;
    in property <string> search-distance;
    in property <bool> retry-calibration;
    in property <bool> can-resume-calibration;
    property <int> reference-kind: 0;
    property <bool> position-advanced-open: false;
    property <bool> fx-scroll-open: true;
    property <bool> fx-outline-open: true;
    property <bool> fx-glow-open: true;
    property <bool> fx-gradient-open: true;
    property <bool> fx-shadow-open: true;
    property <bool> fx-shimmer-open: true;
    in-out property <bool> settings-open: false;
    in-out property <int> settings-tab: 0;
    in-out property <bool> hotkey-recording: false;
    in property <string> hotkey-text: "Ctrl+Alt+O";
    in property <bool> hotkey-ok: true;
    in property <bool> startup-enabled: false;
    in property <string> app-version: "dev";
    in property <bool> can-select-target: false;
    in property <bool> can-draw: false;
    in property <int> engine-pid: 0;
    in property <string> canvas-mode: "idle";
    in property <string> loaded-text;
    in property <string> target-name: "选择应用";
    in property <[TargetRow]> targets;
    in-out property <string> expanded-group;
    in-out property <int> expanded-action: -1;
    in-out property <bool> expanded-management;
    property <length> target-menu-height: 210px;
    in-out property <bool> choosing-target: false;
    in-out property <int> theme-mode: 0;
    in-out property <bool> dark: false;
    init => {
        Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light;
        root.selector-bounds-changed(150 + round(target-selector-shell.width / 1px));
        shortcuts.focus();
    }
    changed dark => { Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light; }
    in-out property <bool> confirm-delete: false;
    in-out property <bool> confirm-clear: false;
    property <bool> region-menu-open;
    property <length> region-menu-y;
    in property <bool> managing-targets;
    in-out property <int> pending-target: -1;
    in-out property <bool> scope-picker-open: false;
    in-out property <bool> app-manager-open: false;
    in-out property <int> managed-app-index: 0;
    in property <[ManagedAppItem]> managed-apps;
    in property <[ManagedWindowItem]> managed-windows;
    in property <[ManagedProfileItem]> managed-profiles;
    in-out property <bool> manager-confirm-open: false;
    in-out property <string> manager-confirm-title: "";
    in-out property <string> manager-confirm-detail: "";
    in-out property <string> manager-confirm-kind: "";
    in-out property <int> manager-confirm-item: -1;
    in-out property <bool> color-picker-open: false;
    in-out property <string> color-picker-key: "";
    in-out property <string> color-picker-title: "";
    in-out property <string> color-picker-eyedropper-key: "";
    in-out property <string> color-picker-hex: "#ffffff";
    in-out property <color> color-picker-preview: #ffffff;
    in-out property <color> color-picker-hue-color: #ff0000;
    in-out property <float> color-picker-h: 0;
    in-out property <float> color-picker-s: 0;
    in-out property <float> color-picker-v: 100;
    in-out property <[string]> recent-color-hexes: ["#212121", "#ececec", "#c9ee46", "#2ab89d", "#58a6ff", "#ff5c6c", "#1e1e2e", "#ffffff"];
    in-out property <[color]> recent-color-swatches: [#212121, #ececec, #c9ee46, #2ab89d, #58a6ff, #ff5c6c, #1e1e2e, #ffffff];
    in property <bool> has-copied-style: false;
    in property <bool> can-undo: false;
    in property <bool> can-redo: false;
    in-out property <int> page: 0;
    in property <[Setting]> settings;
    property <color> ink: root.dark ? #f3eff9 : #252338;
    property <color> muted: root.dark ? #c3bdd6 : #57536e;
    property <bool> compact-form: root.width < 830px;
    property <color> paper: root.dark ? #302a43 : #f5f2fa;
    property <color> border: root.dark ? #746e8d : #bcb7cf;
    property <color> selection: root.dark ? #423854 : #f5f1fb;
    callback choose(int);
    callback open-targets();
    callback manage-targets();
    callback choose-target(int);
    callback select-managed-app(int);
    callback manager-action(string, int);
    callback open-color-picker(string, string, string, string);
    callback preview-color-hsv(float, float, float);
    callback commit-color-hsv(float, float, float);
    callback select-color-hex(string);
    callback set-canvas-mode(string);
    callback set-page(int);
    callback set-option(string, string, int);
    callback preview-option(string, string);
    callback draft-edited(string);
    callback cycle-theme();
    callback selector-bounds-changed(int);
    callback minimize();
    callback copy-style();
    callback paste-style();
    callback toggle-region-hidden(int);
    callback duplicate-region();
    callback undo();
    callback redo();
    callback set-hotkey(string);
    callback toggle-startup();
    callback open-config-dir();
    callback set-theme-mode(int);
    callback open-repo-url();
    callback apply();
    callback finish();

    Rectangle {
        clip: true;
        border-radius: 8px;
        border-width: 1px;
        border-color: root.border;
        Rectangle {
            x: -parent.width * 0.36; y: -parent.height * 0.46;
            width: parent.width * 1.16; height: parent.height * 1.36;
            background: root.dark
                ? @radial-gradient(circle, #3c30517d 0%, #3c305100 48%)
                : @radial-gradient(circle, #d8cfee7d 0%, #d8cfee00 48%);
        }
        Rectangle {
            x: parent.width * 0.22; y: parent.height * 0.06;
            width: parent.width * 1.42; height: parent.height * 1.72;
            background: root.dark
                ? @radial-gradient(circle, #3c3051b9 0%, #3c305100 48%)
                : @radial-gradient(circle, #d8cfeeb9 0%, #d8cfee00 48%);
        }
    }
    SurfaceShadow {
        x: rail-surface.x + body.x;
        y: rail-surface.y + body.y;
        width: rail-surface.width; height: rail-surface.height;
        dark: root.dark;
    }
    SurfaceShadow {
        x: work-surface.x + work.x + body.x;
        y: work-surface.y + work.y + body.y;
        width: work-surface.width; height: work-surface.height;
        dark: root.dark;
    }
    target-measure := Text {
        opacity: 0;
        x: -9999px;
        y: -9999px;
        text: root.target-name;
        font-family: "Microsoft YaHei UI";
        font-size: 13px;
        font-weight: 400;
    }
    shortcuts := FocusScope {
        width: parent.width;
        height: parent.height;
        key-pressed(event) => {
            if event.text == Key.Escape {
                if root.color-picker-open {
                    root.color-picker-open = false;
                    return accept;
                }
                if root.hotkey-recording {
                    root.hotkey-recording = false;
                    return accept;
                }
                if root.settings-open {
                    root.settings-open = false;
                    return accept;
                }
                if root.manager-confirm-open {
                    root.manager-confirm-open = false;
                    return accept;
                }
                if root.app-manager-open {
                    root.app-manager-open = false;
                    return accept;
                }
                if root.scope-picker-open {
                    root.scope-picker-open = false;
                    return accept;
                }
                if root.pending-target >= 0 {
                    root.pending-target = -1;
                    return accept;
                }
                if root.choosing-target {
                    root.choosing-target = false;
                    return accept;
                }
                if root.region-menu-open || root.confirm-clear || root.confirm-delete {
                    root.region-menu-open = false;
                    root.confirm-clear = false;
                    root.confirm-delete = false;
                    return accept;
                }
                if root.canvas-mode == "free" || root.canvas-mode == "once" || root.canvas-mode == "cover_draft" {
                    root.set-canvas-mode("idle");
                    return accept;
                }
                if root.calibration-open {
                    root.set-option("cancel_calibration", "", -1);
                    return accept;
                }
                return reject;
            }
            if event.modifiers.control && (event.text == "s" || event.text == "S") {
                if root.loaded-text != root.draft && !root.busy {
                    root.apply();
                }
                return accept;
            }
            if event.modifiers.control && !event.modifiers.shift && (event.text == "z" || event.text == "Z") {
                if root.can-undo && !root.busy {
                    root.undo();
                }
                return accept;
            }
            if event.modifiers.control && ((event.text == "y" || event.text == "Y") || (event.modifiers.shift && (event.text == "z" || event.text == "Z"))) {
                if root.can-redo && !root.busy {
                    root.redo();
                }
                return accept;
            }
            if event.modifiers.control && (event.text == "d" || event.text == "D") {
                if root.selected >= 0 && !root.busy && root.canvas-mode == "idle" {
                    root.duplicate-region();
                }
                return accept;
            }
            if event.modifiers.alt && event.text == Key.UpArrow {
                if !root.busy && root.canvas-mode == "idle" && root.selected > 0 {
                    root.choose(root.selected - 1);
                }
                return accept;
            }
            if event.modifiers.alt && event.text == Key.DownArrow {
                if !root.busy && root.canvas-mode == "idle" && root.selected >= 0 && root.selected + 1 < root.region-items.length {
                    root.choose(root.selected + 1);
                }
                return accept;
            }
            return reject;
        }
        VerticalLayout {
        padding-left: 23px;
        padding-right: 23px;
        padding-top: 14px;
        padding-bottom: 11px;
        spacing: 15px;
        HorizontalLayout {
            height: 44px;
            spacing: 5px;
            HorizontalLayout {
                width: 122px;
                spacing: 1px;
                alignment: start;
                Text {
                    text: "Its";
                    font-family: "Segoe UI"; font-size: 21px; font-weight: 700;
                    color: root.ink; vertical-alignment: center;
                }
                Rectangle {
                    width: 24px; height: 24px; y: 10px;
                    Path {
                        width: 24px; height: 24px;
                        viewbox-width: 24; viewbox-height: 24;
                        fill: #ff9bb3;
                        commands: "M 3 10 L 1 4 L 7 6 Z M 11 6 L 16 3 L 15 9 Z";
                    }
                    Rectangle {
                        x: 2px; y: 5px; width: 14px; height: 14px; border-radius: 7px;
                        background: #ff9bb3;
                    }
                    Rectangle {
                        x: 6px; y: 5px; width: 17px; height: 17px; border-radius: 8.5px;
                        background: root.dark ? #272338 : #eeecf6;
                    }
                    Rectangle {
                        x: 7px; y: 6px; width: 15px; height: 15px; border-radius: 7.5px;
                        border-width: 3px; border-color: #c9ee46; background: transparent;
                    }
                }
                Text {
                    text: "verlay";
                    font-family: "Segoe UI"; font-size: 21px; font-weight: 700;
                    color: root.ink; vertical-alignment: center;
                }
            }
            target-selector-shell := Rectangle {
                min-width: 145px;
                preferred-width: max(145px, target-measure.preferred-width * 1.24 + 104px);
                horizontal-stretch: 0;
                height: 44px;
                border-radius: 9px;
                changed width => { root.selector-bounds-changed(150 + round(self.width / 1px)); }
                Rectangle {
                    x: 0px;
                    y: 0px;
                    width: 18px;
                    height: parent.height;
                    border-radius: 9px;
                    background: #c9ee46;
                }
                Rectangle {
                    x: 9px;
                    y: 0px;
                    width: max(0px, parent.width - 9px);
                    height: parent.height;
                    background: @linear-gradient(90deg, #c9ee46ff 0%, #c9ee46d8 40%, #c9ee4666 75%, #c9ee4600 100%);
                }
                target-selector := PanelButton {
                    x: 2px;
                    y: 2px;
                    width: parent.width - 4px;
                    height: parent.height - 4px;
                    border-radius: 7px;
                    dark: root.dark;
                    selector: true;
                    text: root.target-name;
                    enabled: root.can-select-target && !root.busy;
                    clicked => {
                        if root.choosing-target { root.choosing-target = false; root.pending-target = -1; }
                        else { root.open-targets(); }
                    }
                    Rectangle { x: 4px; y: 5px; width: 30px; height: 30px; border-radius: 7px; background: #c9ee46;
                        for corner in [0, 1, 2, 3]: Rectangle {
                            x: mod(corner, 2) == 0 ? 8px : 17px;
                            y: corner < 2 ? 8px : 17px;
                            width: 5px; height: 5px;
                            Rectangle { width: 5px; height: 2px; y: corner < 2 ? 0px : 3px; background: #252338; }
                            Rectangle { width: 2px; height: 5px; x: mod(corner, 2) == 0 ? 0px : 3px; background: #252338; }
                        }
                    }
                    Path {
                        x: parent.width - 20px; y: 18px; width: 8px; height: 5px;
                        stroke: root.ink; stroke-width: 1.5px;
                        commands: "M 0 0 L 4 4 L 8 0";
                    }
                }
            }
            Rectangle { horizontal-stretch: 1; min-width: 8px; }
            PanelButton {
                width: 32px;
                dark: root.dark;
                quiet: true;
                accessible-label: "最小化面板";
                clicked => { root.minimize(); }
                Path {
                    x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                    width: 18px; height: 18px; stroke: root.ink; stroke-width: 1.6px;
                    commands: "M 4 13 H 14";
                }
            }
            PanelButton {
                width: 32px;
                dark: root.dark;
                quiet: true;
                accessible-label: "设置与帮助";
                clicked => {
                    root.hotkey-recording = false;
                    root.settings-tab = 0;
                    root.settings-open = true;
                }
                Path {
                    x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                    width: 18px; height: 18px;
                    viewbox-width: 24; viewbox-height: 24;
                    stroke: root.ink; stroke-width: 1.6px;
                    commands: "M 10.5 2 L 13.5 2 L 14 4.6 L 15.7 5.3 L 17.9 3.8 L 20.1 6 L 18.6 8.2 L 19.3 10 L 22 10.5 L 22 13.5 L 19.3 14 L 18.6 15.8 L 20.1 18 L 17.9 20.2 L 15.7 18.7 L 14 19.4 L 13.5 22 L 10.5 22 L 10 19.4 L 8.3 18.7 L 6.1 20.2 L 3.9 18 L 5.4 15.8 L 4.7 14 L 2 13.5 L 2 10.5 L 4.7 10 L 5.4 8.2 L 3.9 6 L 6.1 3.8 L 8.3 5.3 L 10 4.6 Z M 12 15 A 3 3 0 1 0 12 9 A 3 3 0 1 0 12 15 Z";
                }
            }
            PanelButton {
                width: 32px;
                dark: root.dark;
                quiet: true;
                accessible-label: root.theme-mode == 0 ? "主题：跟随系统（点击切换浅色）"
                    : root.theme-mode == 1 ? "主题：浅色（点击切换深色）"
                    : "主题：深色（点击切换跟随系统）";
                clicked => { root.cycle-theme(); }
                if root.theme-mode == 0: Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 22px;
                    height: 20px;
                    Text {
                        x: 0px; y: 0px; width: parent.width; height: 10px;
                        text: "AU";
                        color: root.ink;
                        font-family: "Segoe UI";
                        font-size: 9px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    Text {
                        x: 0px; y: 10px; width: parent.width; height: 10px;
                        text: "TO";
                        color: root.ink;
                        font-family: "Segoe UI";
                        font-size: 9px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                if root.theme-mode != 0: Path {
                    x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                    width: 18px; height: 18px; stroke: root.ink; stroke-width: 1.6px;
                    commands: root.theme-mode == 2
                        ? "M 14.9 12.6 A 7 7 0 0 1 5.4 3.1 A 7.4 7.4 0 1 0 14.9 12.6 Z"
                        : "M 12.5 9 A 3.5 3.5 0 1 0 5.5 9 A 3.5 3.5 0 1 0 12.5 9 Z M 9 1 V 3 M 9 15 V 17 M 1 9 H 3 M 15 9 H 17 M 3.3 3.3 L 4.7 4.7 M 13.3 13.3 L 14.7 14.7 M 3.3 14.7 L 4.7 13.3 M 13.3 4.7 L 14.7 3.3";
                }
            }
            PanelButton {
                width: 32px;
                dark: root.dark;
                quiet: true;
                accessible-label: "关闭面板";
                enabled: !root.busy;
                clicked => { root.finish(); }
                Path {
                    x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                    width: 18px; height: 18px; stroke: root.ink; stroke-width: 1.6px;
                    commands: "M 3 3 L 15 15 M 15 3 L 3 15";
                }
            }
        }
        body := HorizontalLayout {
            spacing: 23px;
            vertical-stretch: 1;
            rail-surface := GlassSurface {
                width: 220px;
                dark: root.dark;
                fill: root.dark ? #2d26407d : #e4ddf07a;
                border-radius: 11px;
                edge: root.border;
                VerticalLayout {
                    padding: 10px;
                    spacing: 8px;
                    Text { text: "遮盖区域"; color: root.muted; font-size: 13px; height: 20px; }
                    HorizontalLayout {
                        height: 36px;
                        spacing: 4px;
                        PanelButton {
                            text: root.canvas-mode == "once" ? "取消" : "新建";
                            icon: "add";
                            enabled: root.can-draw && !root.busy && root.canvas-mode != "free";
                            dark: root.dark;
                            clicked => { root.set-canvas-mode(root.canvas-mode == "once" ? "idle" : "once"); }
                        }
                        PanelButton {
                            text: root.canvas-mode == "free" ? "结束" : "连选";
                            icon: "frame";
                            enabled: root.can-draw && !root.busy;
                            dark: root.dark;
                            clicked => { root.set-canvas-mode(root.canvas-mode == "free" ? "idle" : "free"); }
                        }
                        PanelButton {
                            text: "清空"; icon: "delete";
                            danger: true;
                            enabled: root.region-items.length > 0 && !root.busy && root.canvas-mode == "idle";
                            dark: root.dark;
                            clicked => { root.confirm-clear = true; }
                        }
                    }
                    if root.region-items.length == 0: VerticalLayout {
                        vertical-stretch: 1;
                        alignment: center;
                        padding: 12px;
                        spacing: 6px;
                        Text {
                            text: "暂无遮盖区域";
                            color: root.ink;
                            font-size: 13px;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: root.can-draw ? "点上方「新建」框选 1 个区域，或「连选」连续框选多个。" : "先在顶部选择目标应用，再框选遮盖区域。";
                            color: root.muted;
                            font-size: 11px;
                            wrap: word-wrap;
                            horizontal-alignment: center;
                        }
                    }
                    if root.region-items.length > 0: ListView {
                        vertical-stretch: 1;
                        for item[index] in root.region-items: Rectangle {
                            height: 55px;
                            border-radius: 8px;
                            background: root.selected == index ? root.selection : hit.has-hover ? root.paper : transparent;
                            Rectangle {
                                x: 1px; y: 8px; width: 2px; height: 34px;
                                visible: root.selected == index;
                                border-radius: 1px; background: #c9ee46;
                            }
                            Rectangle {
                                x: 7px; y: 12px; width: 26px; height: 26px; border-radius: 6px;
                                background: item.bg;
                                opacity: item.hidden ? 0.42 : 1.0;
                                border-width: 1px;
                                border-color: root.selected == index ? #c9ee46 : (root.dark ? #ffffff35 : #00000025);
                                Text {
                                    text: "Aa";
                                    color: item.fg;
                                    font-size: 10px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                if item.status-kind != "normal": Rectangle {
                                    x: parent.width - 6px;
                                    y: -2px;
                                    width: 8px;
                                    height: 8px;
                                    border-radius: 4px;
                                    border-width: 1px;
                                    border-color: root.dark ? #2d2640 : #f5f2fa;
                                    background: item.status-kind == "ok" ? #c9ee46
                                        : item.status-kind == "pending" ? #ffb84d
                                        : #ff6b7a;
                                }
                            }
                            Text {
                                x: 39px; y: 5px; width: parent.width - 101px; height: 23px;
                                vertical-alignment: center;
                                opacity: item.hidden ? 0.55 : 1.0;
                                overflow: elide; text: item.title; color: root.ink; font-size: 14px; font-weight: 600;
                            }
                            Text {
                                x: 39px; y: 28px; width: parent.width - 101px; height: 18px;
                                text: item.detail;
                                overflow: elide;
                                color: item.status-kind == "warn" ? (root.dark ? #ff9e80 : #b32140) : root.muted;
                                font-size: 11px;
                            }
                            hit := TouchArea {
                                width: parent.width - 60px;
                                enabled: !root.busy && root.canvas-mode == "idle";
                                clicked => { root.confirm-delete = false; root.choose(index); }
                            }
                            PanelButton {
                                x: parent.width - 58px; y: 10px; width: 25px; height: 31px; dark: root.dark; tab: true;
                                accessible-label: item.hidden ? "显示区域" : "隐藏区域";
                                enabled: !root.busy && root.canvas-mode == "idle";
                                clicked => { root.toggle-region-hidden(index); }
                                Path {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    width: 14px; height: 14px;
                                    stroke: item.hidden ? root.muted : root.ink;
                                    stroke-width: 1.4px;
                                    commands: item.hidden
                                        ? "M 1 7 C 3.5 3 10.5 3 13 7 C 10.5 11 3.5 11 1 7 Z M 2 12 L 12 2"
                                        : "M 1 7 C 3.5 3 10.5 3 13 7 C 10.5 11 3.5 11 1 7 Z M 5 7 C 5 5.9 5.9 5 7 5 C 8.1 5 9 5.9 9 7 C 9 8.1 8.1 9 7 9 C 5.9 9 5 8.1 5 7 Z";
                                }
                            }
                            menu-button := PanelButton {
                                x: parent.width - 31px; y: 10px; width: 26px; height: 31px; dark: root.dark; tab: true; text: "···";
                                accessible-label: "区域操作";
                                enabled: !root.busy && root.canvas-mode == "idle";
                                clicked => {
                                    if root.selected != index { root.choose(index); }
                                    root.region-menu-y = menu-button.absolute-position.y + menu-button.height;
                                    root.region-menu-open = true;
                                }
                            }
                        }
                    }
                }
            }
            work := VerticalLayout {
                horizontal-stretch: 1;
                spacing: 7px;
                Text { text: root.selected >= 0 ? root.region-items[root.selected].title : "选择遮盖区域";
                    height: 33px; font-size: 22px; font-weight: 400; color: root.ink; overflow: elide; vertical-alignment: center; }
                HorizontalLayout {
                    height: 36px;
                    spacing: 6px;
                    alignment: start;
                    for label[index] in ["外观与文字", "定位与追踪", "特效"]: PanelButton {
                        width: 96px; dark: root.dark; tab: true;
                        text: label;
                        active: root.page == index;
                        enabled: !root.busy;
                        clicked => { root.set-page(index); }
                    }
                }
                work-surface := GlassSurface {
                    vertical-stretch: 1;
                    dark: root.dark;
                    border-radius: 11px;
                    edge: root.border;
                    fill: root.dark ? #382f4ca0 : #fffaff7d;
                    VerticalLayout {
                        padding-left: 16px;
                        padding-top: 14px;
                        padding-bottom: 14px;
                        padding-right: 2px;
                        spacing: 10px;
                        if root.canvas-mode != "idle" || root.calibration-open: HorizontalLayout {
                            padding-right: 12px;
                            Rectangle {
                                horizontal-stretch: 1;
                                border-radius: 9px;
                                border-width: 1px;
                                border-color: #c9ee46;
                                background: root.dark ? #3d3456 : #f6fae4;
                                HorizontalLayout {
                                padding-left: 12px; padding-right: 8px; padding-top: 7px; padding-bottom: 7px;
                                spacing: 8px;
                                Text {
                                    horizontal-stretch: 1;
                                    color: root.ink; font-size: 12px; vertical-alignment: center; wrap: word-wrap;
                                    text: root.calibration-open ? "校准预览：请在目标窗口框选参考内容，预览无误后点击「确认校准」。"
                                        : root.canvas-mode == "cover_draft" ? "拖动模式：在目标窗口调整遮盖位置，完成后点击「保存位置」。"
                                        : root.canvas-mode == "once" ? "框选模式：请在目标窗口中拖出一个遮盖区域（按 Esc 取消）。"
                                        : "连选模式：可在目标窗口连续拖出多个遮盖区域。";
                                }
                                if root.calibration-open && root.calibration-has-reference: PanelButton {
                                    width: 78px; dark: root.dark; primary: true; enabled: !root.busy; text: "确认校准";
                                    clicked => { root.set-option("confirm_calibration", "", -1); }
                                }
                                if root.calibration-open: PanelButton {
                                    width: 68px; dark: root.dark; enabled: !root.busy; text: "重选";
                                    clicked => { root.set-option("pick_calibration_reference", "", -1); }
                                }
                                if root.canvas-mode == "cover_draft": PanelButton {
                                    width: 78px; dark: root.dark; primary: true; enabled: !root.busy; text: "保存位置";
                                    clicked => { root.set-option("commit_cover_drag", "", -1); }
                                }
                                PanelButton {
                                    width: 76px; dark: root.dark; enabled: !root.busy;
                                    text: root.calibration-open ? "取消校准" : root.canvas-mode == "free" ? "结束连选" : "取消";
                                    clicked => {
                                        if root.calibration-open { root.set-option("cancel_calibration", "", -1); }
                                        else { root.set-canvas-mode("idle"); }
                                    }
                                }
                            }
                            }
                        }
                        if root.selected < 0: VerticalLayout {
                            vertical-stretch: 1;
                            alignment: center;
                            padding-right: 12px;
                            spacing: 10px;
                            Text {
                                text: root.busy ? "正在加载面板数据…" : root.can-draw ? "还没有遮盖区域" : "还没有选定目标窗口";
                                color: root.ink;
                                font-size: 15px;
                                font-weight: 500;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: root.busy ? "请稍候。"
                                    : root.can-draw ? "点击左侧「新建」在目标窗口拖出第一个遮盖区域，或在左侧列表中选择已有区域。"
                                    : "点击左上角应用选择器选定目标窗口后，即可新建或调整遮盖区域。";
                                color: root.muted;
                                font-size: 12px;
                                wrap: word-wrap;
                                horizontal-alignment: center;
                            }
                            if !root.busy: HorizontalLayout {
                                alignment: center;
                                spacing: 8px;
                                if root.can-draw: PanelButton {
                                    width: 120px; dark: root.dark; primary: true; text: "新建遮盖区域";
                                    clicked => { root.set-canvas-mode("once"); }
                                }
                                if !root.can-draw && root.can-select-target: PanelButton {
                                    width: 120px; dark: root.dark; primary: true; text: "选择目标应用";
                                    clicked => { root.open-targets(); }
                                }
                            }
                        }

                        // Tab 0: 外观与文字
                        if root.selected >= 0 && root.page == 0: ScrollView {
                            vertical-stretch: 1;
                            content-width: self.visible-width;
                            VerticalLayout {
                                width: parent.visible-width - 22px;
                                spacing: 8px;
                                Text { height: 18px; text: "遮盖文字"; color: root.ink; font-size: 13px; }
                                cover-editor := PanelTextField {
                                    height: 68px;
                                    multiline: true;
                                    dark: root.dark;
                                    enabled: root.selected >= 0 && !root.busy && root.canvas-mode == "idle";
                                    text <=> root.draft;
                                    edited(value) => { root.draft-edited(value); }
                                    blurred(value) => {
                                        if root.loaded-text != root.draft && !root.busy {
                                            root.apply();
                                        }
                                    }
                                }
                                if root.settings.length == 13: SectionCard {
                                    dark: root.dark;
                                    VerticalLayout {
                                        padding: 10px;
                                        spacing: 8px;
                                        HorizontalLayout {
                                            height: 32px;
                                            spacing: 8px;
                                            Text { width: 64px; text: "字体字号"; color: root.ink; font-size: 13px; vertical-alignment: center; }
                                            PanelCombo {
                                                horizontal-stretch: 3;
                                                model: root.settings[0].choices; current-index: root.settings[0].choice;
                                                enabled: !root.busy; dark: root.dark; editable: true; value: root.settings[0].value;
                                                selected(index) => {
                                                    if index >= 0 && index < root.settings[0].choices.length {
                                                        root.set-option("font", root.settings[0].choices[index], -1);
                                                    }
                                                }
                                                accepted(value) => { root.set-option("font", value, -1); }
                                            }
                                            PanelTextField {
                                                width: 54px; horizontal-stretch: 0;
                                                dark: root.dark; text: root.settings[1].value; enabled: !root.busy;
                                                accepted(value) => { root.set-option("size", value, -1); }
                                            }
                                            PanelButton {
                                                width: 34px; text: "B"; dark: root.dark;
                                                primary: root.settings[2].choice == 1; enabled: !root.busy;
                                                clicked => { root.set-option("bold", "", root.settings[2].choice == 1 ? 0 : 1); }
                                            }
                                            if !root.compact-form: SegmentedControl {
                                                width: 114px;
                                                choices: ["左", "中", "右"];
                                                current: root.settings[3].choice;
                                                dark: root.dark; enabled: !root.busy;
                                                selected(idx) => { root.set-option("align", "", idx); }
                                            }
                                        }
                                        if root.compact-form: HorizontalLayout {
                                            height: 32px;
                                            spacing: 8px;
                                            Text { width: 64px; text: "文字对齐"; color: root.ink; font-size: 13px; vertical-alignment: center; }
                                            SegmentedControl {
                                                horizontal-stretch: 1;
                                                choices: ["左对齐", "居中", "右对齐"];
                                                current: root.settings[3].choice;
                                                dark: root.dark; enabled: !root.busy;
                                                selected(idx) => { root.set-option("align", "", idx); }
                                            }
                                        }
                                        ColorSettingRow {
                                            label: "文字颜色";
                                            label-width: 64px;
                                            setting: root.settings[6];
                                            preset-hexes: ["#ffffff", "#ececec", "#1d1b2d", "#c9ee46", "#ff5c6c"];
                                            preset-colors: [#ffffff, #ececec, #1d1b2d, #c9ee46, #ff5c6c];
                                            show-eyedropper: true;
                                            eyedropper-key: "pick_text";
                                            dark: root.dark; busy: root.busy; ink: root.ink;
                                            edit(key, value, index) => { root.set-option(key, value, index); }
                                            open-picker(key, title, hex, eye) => { root.open-color-picker(key, title, hex, eye); }
                                        }
                                        HorizontalLayout {
                                            height: 32px;
                                            spacing: 12px;
                                            SettingControl {
                                                horizontal-stretch: 1; label-width: 64px; setting: root.settings[4];
                                                dark: root.dark; busy: root.busy; ink: root.ink;
                                                edit(key, value, index) => { root.set-option(key, value, index); }
                                            }
                                            SettingControl {
                                                horizontal-stretch: 1; label-width: 44px; setting: root.settings[5];
                                                dark: root.dark; busy: root.busy; ink: root.ink;
                                                edit(key, value, index) => { root.set-option(key, value, index); }
                                            }
                                        }
                                    }
                                }
                                if root.settings.length == 13: SectionCard {
                                    dark: root.dark;
                                    VerticalLayout {
                                        padding: 10px;
                                        spacing: 8px;
                                        SettingControl {
                                            height: 34px; label-width: 64px; setting: root.settings[7];
                                            dark: root.dark; busy: root.busy; ink: root.ink;
                                            edit(key, value, index) => { root.set-option(key, value, index); }
                                            preview(key, value) => { root.preview-option(key, value); }
                                        }
                                        ColorSettingRow {
                                            label: "背景颜色";
                                            label-width: 64px;
                                            setting: root.settings[8];
                                            preset-hexes: ["#212121", "#000000", "#1e1e2e", "#ffffff", "#f5f5f5", "#f7f3e9"];
                                            preset-colors: [#212121, #000000, #1e1e2e, #ffffff, #f5f5f5, #f7f3e9];
                                            show-eyedropper: true;
                                            eyedropper-key: "pick_background";
                                            dark: root.dark; busy: root.busy; ink: root.ink;
                                            edit(key, value, index) => { root.set-option(key, value, index); }
                                            open-picker(key, title, hex, eye) => { root.open-color-picker(key, title, hex, eye); }
                                        }
                                        SettingControl {
                                            height: 32px; label-width: 64px; setting: root.settings[9];
                                            dark: root.dark; busy: root.busy; ink: root.ink;
                                            edit(key, value, index) => { root.set-option(key, value, index); }
                                            preview(key, value) => { root.preview-option(key, value); }
                                        }
                                        HorizontalLayout {
                                            height: 28px; spacing: 8px;
                                            Text { width: 64px; text: "卡片边框"; color: root.ink; font-size: 13px; vertical-alignment: center; }
                                            Text {
                                                horizontal-stretch: 1; color: root.muted; font-size: 12px; vertical-alignment: center;
                                                text: root.settings[10].choice == 1 ? "已开启边框描边" : "已关闭";
                                            }
                                            ToggleSwitch {
                                                y: 3px; dark: root.dark; checked: root.settings[10].choice == 1; enabled: !root.busy;
                                                accessible-label: "卡片边框";
                                                clicked => { root.set-option("border", "", root.settings[10].choice == 1 ? 0 : 1); }
                                            }
                                        }
                                        if root.settings[10].choice == 1: SettingControl {
                                            height: 32px; label-width: 64px; setting: root.settings[11];
                                            dark: root.dark; busy: root.busy; ink: root.ink;
                                            edit(key, value, index) => { root.set-option(key, value, index); }
                                            preview(key, value) => { root.preview-option(key, value); }
                                        }
                                        if root.settings[10].choice == 1: ColorSettingRow {
                                            label: "边框颜色";
                                            label-width: 64px;
                                            setting: root.settings[12];
                                            preset-hexes: ["#c9ee46", "#ffffff", "#2ab89d", "#58a6ff", "#ff6b9d"];
                                            preset-colors: [#c9ee46, #ffffff, #2ab89d, #58a6ff, #ff6b9d];
                                            dark: root.dark; busy: root.busy; ink: root.ink;
                                            edit(key, value, index) => { root.set-option(key, value, index); }
                                            open-picker(key, title, hex, eye) => { root.open-color-picker(key, title, hex, eye); }
                                        }
                                    }
                                }
                            }
                        }

                        // Tab 1: 定位与追踪
                        if root.selected >= 0 && root.page == 1: ScrollView {
                            vertical-stretch: 1;
                            content-width: self.visible-width;
                            VerticalLayout {
                                width: parent.visible-width - 22px;
                                spacing: 10px;
                                HorizontalLayout {
                                    height: 36px;
                                    spacing: 10px;
                                    Text { width: 64px; text: "定位模式"; color: root.ink; font-size: 13px; vertical-alignment: center; }
                                    SegmentedControl {
                                        horizontal-stretch: 1;
                                        choices: ["窗口固定", "视觉追踪"];
                                        current: (root.visual-position || root.calibration-open) ? 1 : 0;
                                        dark: root.dark; enabled: !root.busy;
                                        selected(idx) => {
                                            if idx == 0 {
                                                if root.calibration-open { root.set-option("cancel_calibration", "", -1); }
                                                else if root.visual-position { root.set-option("anchor", "", -1); }
                                            } else if !root.visual-position && !root.calibration-open {
                                                if root.can-resume-calibration { root.set-option("resume", "", -1); }
                                                else { root.set-option(root.reference-kind == 0 ? "begin_features" : "begin_boundary", "", -1); }
                                            }
                                        }
                                    }
                                }

                                // 窗口固定
                                if !root.visual-position && !root.calibration-open && root.settings.length == 6 && root.settings[0].key == "x": SectionCard {
                                    dark: root.dark;
                                    VerticalLayout {
                                        padding: 12px;
                                        spacing: 8px;
                                        for row in [0, 2]: HorizontalLayout {
                                            height: 33px;
                                            spacing: 10px;
                                            for column in [0, 1]: SettingControl {
                                                setting: root.settings[row + column];
                                                horizontal-stretch: 1; label-width: 34px; stepper: true;
                                                dark: root.dark; busy: root.busy; ink: root.ink;
                                                edit(key, value, index) => { root.set-option(key, value, index); }
                                            }
                                        }
                                        for index in [4, 5]: SettingControl {
                                            height: 33px; label-width: 64px;
                                            setting: root.settings[index];
                                            dark: root.dark; busy: root.busy; ink: root.ink;
                                            edit(key, value, index) => { root.set-option(key, value, index); }
                                        }
                                    }
                                }
                                if !root.visual-position && !root.calibration-open: SectionCard {
                                    dark: root.dark;
                                    HorizontalLayout {
                                        padding: 12px;
                                        spacing: 10px;
                                        Text {
                                            horizontal-stretch: 1;
                                            color: root.muted; font-size: 12px; wrap: word-wrap; vertical-alignment: center;
                                            text: "当前使用窗口边缘/中心锚定。如果遮盖的文字或按钮会随窗口内部排版移动，可改用视觉追踪。";
                                        }
                                        PanelButton {
                                            width: 128px; dark: root.dark; primary: true; enabled: !root.busy;
                                            text: root.can-resume-calibration ? "恢复视觉追踪" : "选参考区域…";
                                            clicked => {
                                                root.set-option(root.can-resume-calibration ? "resume"
                                                    : root.reference-kind == 0 ? "begin_features" : "begin_boundary", "", -1);
                                            }
                                        }
                                    }
                                }

                                // 视觉追踪
                                if root.visual-position || root.calibration-open: SectionCard {
                                    dark: root.dark;
                                    VerticalLayout {
                                        padding: 12px;
                                        spacing: 10px;
                                        Text {
                                            color: root.cover-outside ? (root.dark ? #ff9e80 : #b32140) : root.ink;
                                            font-size: 13px; wrap: word-wrap;
                                            text: root.visual-status-detail;
                                        }
                                        HorizontalLayout {
                                            height: 32px; spacing: 6px; alignment: start;
                                            PanelButton {
                                                width: 122px; dark: root.dark; primary: true; enabled: !root.busy;
                                                text: root.calibration-open ? "重选参考区域…"
                                                    : root.canvas-mode == "cover_draft" ? "保存遮盖位置"
                                                    : "重选参考区域…";
                                                clicked => {
                                                    root.set-option(root.calibration-open ? "pick_calibration_reference"
                                                        : root.canvas-mode == "cover_draft" ? "commit_cover_drag"
                                                        : root.reference-kind == 0 ? "begin_features" : "begin_boundary", "", -1);
                                                }
                                            }
                                            if root.visual-position && !root.calibration-open && root.canvas-mode != "cover_draft": PanelButton {
                                                width: 102px; dark: root.dark; enabled: !root.busy;
                                                text: root.cover-outside ? "拖回遮盖…" : "拖动遮盖位置";
                                                clicked => { root.set-option("begin_cover_drag", "", -1); }
                                            }
                                            if root.visual-position && !root.calibration-open: PanelButton {
                                                width: 78px; dark: root.dark; enabled: !root.busy; text: "重新定位";
                                                clicked => { root.set-option("refresh_visual", "", -1); }
                                            }
                                            if root.retry-calibration: PanelButton {
                                                width: 78px; dark: root.dark; enabled: !root.busy; text: "重试校准";
                                                clicked => { root.set-option("retry_calibration", "", -1); }
                                            }
                                        }
                                    }
                                }
                                if root.visual-position || root.calibration-open: SectionCard {
                                    dark: root.dark;
                                    VerticalLayout {
                                        padding: 12px;
                                        spacing: 8px;
                                        HorizontalLayout {
                                            height: 32px; spacing: 8px;
                                            Text { width: 104px; text: "参考识别方式"; color: root.ink; font-size: 13px; vertical-alignment: center; }
                                            PanelCombo {
                                                dark: root.dark;
                                                model: ["文字 / 图案位置（无需边框）", "完整边框"];
                                                current-index <=> root.reference-kind;
                                                enabled: !root.busy && !root.calibration-open;
                                            }
                                        }
                                        if root.visual-position && root.search-distance != "" && !root.calibration-open: HorizontalLayout {
                                            height: 32px; spacing: 8px; alignment: start;
                                            Text { width: 104px; text: "找回距离 (DIP)"; color: root.ink; font-size: 13px; vertical-alignment: center; }
                                            PanelTextField {
                                                width: 90px; horizontal-stretch: 0; dark: root.dark;
                                                text: root.search-distance; enabled: !root.busy;
                                                accepted(value) => { root.set-option("search", value, -1); }
                                            }
                                            Text { color: root.muted; font-size: 11px; vertical-alignment: center; text: "输入后失焦或回车即生效"; }
                                        }
                                        if root.settings.length > 0 && root.settings[0].key == "interval": SettingControl {
                                            height: 32px; label-width: 104px;
                                            setting: root.settings[0]; dark: root.dark; busy: root.busy; ink: root.ink;
                                            edit(key, value, index) => { root.set-option(key, value, index); }
                                        }
                                    }
                                }
                                if root.visual-position || root.calibration-open: SectionCard {
                                    dark: root.dark;
                                    VerticalLayout {
                                        padding: 12px;
                                        spacing: root.position-advanced-open ? 8px : 0px;
                                        Rectangle {
                                            height: 28px;
                                            HorizontalLayout {
                                                spacing: 8px;
                                                Path {
                                                    y: 10px; width: 9px; height: 8px;
                                                    stroke: root.muted; stroke-width: 1.5px;
                                                    commands: root.position-advanced-open ? "M 0 2 L 4 6 L 8 2" : "M 2 0 L 6 4 L 2 8";
                                                }
                                                Text {
                                                    horizontal-stretch: 1;
                                                    text: root.position-advanced-open ? "收起高级微调（遮盖关系与参考框）" : "展开高级微调（遮盖关系与参考框）";
                                                    color: root.ink; font-size: 13px; font-weight: 600; vertical-alignment: center;
                                                }
                                            }
                                            TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.position-advanced-open = !root.position-advanced-open; }
                                            }
                                        }
                                        if root.position-advanced-open: VerticalLayout {
                                            spacing: 0px;
                                            for entry in root.settings: Rectangle {
                                                property <bool> shown: (entry.section == 1 || entry.section == 2) && !entry.geometry-tail;
                                                height: shown ? 40px : 0px;
                                                if shown && entry.geometry-pair < 0: SettingControl {
                                                    width: parent.width; height: 32px; label-width: 104px;
                                                    setting: entry; dark: root.dark; busy: root.busy; ink: root.ink;
                                                    edit(key, value, index) => { root.set-option(key, value, index); }
                                                }
                                                if shown && entry.geometry-pair >= 0: HorizontalLayout {
                                                    width: parent.width; height: 32px;
                                                    spacing: 10px;
                                                    for field in [entry, root.settings[entry.geometry-pair]]: SettingControl {
                                                        setting: field; dark: root.dark; busy: root.busy; ink: root.ink;
                                                        label-width: root.compact-form ? 44px : 60px; stepper: true;
                                                        edit(key, value, index) => { root.set-option(key, value, index); }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Tab 2: 特效（6张可折叠开关卡片）
                        if root.selected >= 0 && root.page == 2 && root.settings.length == 27: ScrollView {
                            vertical-stretch: 1;
                            content-width: self.visible-width;
                            VerticalLayout {
                                width: parent.visible-width - 22px;
                                spacing: 10px;
                                SectionCard {
                                    dark: root.dark;
                                    VerticalLayout {
                                        padding: 12px;
                                        spacing: (root.settings[0].choice == 1 && root.fx-scroll-open) ? 10px : 0px;
                                        HorizontalLayout {
                                            height: 28px; spacing: 8px;
                                            Rectangle {
                                                horizontal-stretch: 1;
                                                HorizontalLayout {
                                                    spacing: 8px;
                                                    if root.settings[0].choice == 1: Path {
                                                        y: 10px; width: 9px; height: 8px;
                                                        stroke: root.muted; stroke-width: 1.5px;
                                                        commands: root.fx-scroll-open ? "M 0 2 L 4 6 L 8 2" : "M 2 0 L 6 4 L 2 8";
                                                    }
                                                    Text { text: "文字滚动"; color: root.ink; font-size: 14px; font-weight: 600; vertical-alignment: center; }
                                                    Text {
                                                        horizontal-stretch: 1; color: root.muted; font-size: 12px; vertical-alignment: center;
                                                        text: root.settings[0].choice == 1 ? (root.fx-scroll-open ? "开启循环字幕滚动" : "已开启 · 点击展开") : "已关闭";
                                                    }
                                                }
                                                TouchArea {
                                                    enabled: root.settings[0].choice == 1;
                                                    mouse-cursor: root.settings[0].choice == 1 ? pointer : default;
                                                    clicked => { root.fx-scroll-open = !root.fx-scroll-open; }
                                                }
                                            }
                                            ToggleSwitch {
                                                y: 3px; dark: root.dark; checked: root.settings[0].choice == 1; enabled: !root.busy;
                                                accessible-label: "文字滚动";
                                                clicked => {
                                                    if root.settings[0].choice != 1 { root.fx-scroll-open = true; }
                                                    root.set-option("scroll", "", root.settings[0].choice == 1 ? 0 : 1);
                                                }
                                            }
                                        }
                                        if root.settings[0].choice == 1 && root.fx-scroll-open: HorizontalLayout {
                                            height: 32px; spacing: 8px;
                                            Text { width: 84px; text: "滚动方向"; color: root.ink; font-size: 13px; vertical-alignment: center; }
                                            SegmentedControl {
                                                width: 156px; choices: ["向左", "向右"]; current: root.settings[1].choice;
                                                dark: root.dark; enabled: !root.busy;
                                                selected(idx) => { root.set-option("scroll_direction", "", idx); }
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                        }
                                        if root.settings[0].choice == 1 && root.fx-scroll-open: SettingControl {
                                            height: 32px; label-width: 84px; setting: root.settings[15];
                                            dark: root.dark; busy: root.busy; ink: root.ink;
                                            edit(key, value, index) => { root.set-option(key, value, index); }
                                        }
                                        if root.settings[0].choice == 1 && root.fx-scroll-open: SettingControl {
                                            height: 32px; label-width: 84px; setting: root.settings[2];
                                            dark: root.dark; busy: root.busy; ink: root.ink;
                                            edit(key, value, index) => { root.set-option(key, value, index); }
                                            preview(key, value) => { root.preview-option(key, value); }
                                        }
                                        if root.settings[0].choice == 1 && root.fx-scroll-open: SettingControl {
                                            height: 32px; label-width: 84px; setting: root.settings[3];
                                            dark: root.dark; busy: root.busy; ink: root.ink;
                                            edit(key, value, index) => { root.set-option(key, value, index); }
                                            preview(key, value) => { root.preview-option(key, value); }
                                        }
                                        if root.settings[0].choice == 1 && root.fx-scroll-open: SettingControl {
                                            height: 32px; label-width: 84px; setting: root.settings[4];
                                            dark: root.dark; busy: root.busy; ink: root.ink;
                                            edit(key, value, index) => { root.set-option(key, value, index); }
                                        }
                                        if root.settings[0].choice == 1 && root.fx-scroll-open && root.settings[4].choice == 1: SettingControl {
                                            height: 32px; label-width: 84px; setting: root.settings[5];
                                            dark: root.dark; busy: root.busy; ink: root.ink;
                                            edit(key, value, index) => { root.set-option(key, value, index); }
                                            preview(key, value) => { root.preview-option(key, value); }
                                        }
                                    }
                                }
                                SectionCard {
